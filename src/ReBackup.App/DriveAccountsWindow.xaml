<Window x:Class="ReBackup.App.DriveAccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ReBackup.Shared.Wpf.Localization;assembly=ReBackup.Shared.Wpf"
        xmlns:conn="clr-namespace:ReBackup.Storage.GoogleDrive.Connections;assembly=ReBackup.Storage.GoogleDrive"
        Title="{l:Loc driveaccounts.title}" Width="660" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}">
    <!-- The Google service accounts of the configuration folder: add, edit (double-click), delete. Stored at once. -->
    <StackPanel Margin="20,18">
        <TextBlock Style="{StaticResource TextBlock.Muted}" Margin="0,0,0,12" FontSize="12" TextWrapping="Wrap"
                   Text="{l:Loc driveaccounts.note}" />
        <Border Style="{StaticResource Border.Card}" Padding="0">
            <Grid>
                <ListView x:Name="AccountList" Style="{StaticResource ListView.Table}" SelectionMode="Single" MinHeight="160" MaxHeight="360"
                          ItemsSource="{Binding Accounts}" SelectedItem="{Binding Selected}" MouseDoubleClick="OnRowDoubleClick"
                          AutomationProperties.Name="{l:Loc driveaccounts.title}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{l:Loc common.name}" Width="180">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type conn:DriveAccount}">
                                        <TextBlock Margin="8,0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{l:Loc driveaccounts.column.email}" Width="410">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type conn:DriveAccount}">
                                        <StackPanel Orientation="Horizontal" Margin="8,0">
                                            <TextBlock Style="{StaticResource TextBlock.Mono}" Text="{Binding ClientEmail}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <!-- The key cannot be read on this Windows account -->
                                            <TextBlock Margin="8,0,0,0" Foreground="{DynamicResource Brush.Warning}"
                                                       Text="{l:Loc driveaccounts.needsKey}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NeedsKey}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- No accounts yet -->
                <TextBlock Style="{StaticResource TextBlock.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False" Text="{l:Loc driveaccounts.empty}">
                    <TextBlock.Visibility>
                        <Binding Path="IsEmpty">
                            <Binding.Converter>
                                <BooleanToVisibilityConverter />
                            </Binding.Converter>
                        </Binding>
                    </TextBlock.Visibility>
                </TextBlock>

                <!-- The file cannot be read; it is left as it is -->
                <TextBlock Margin="16,0" Foreground="{DynamicResource Brush.Danger}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" IsHitTestVisible="False" Text="{Binding LoadError}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LoadError}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <DockPanel Margin="0,18,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="{l:Loc s3connections.add}" MinWidth="96" Command="{Binding AddCommand}"
                    AutomationProperties.Name="{l:Loc s3connections.add}" />
            <Button DockPanel.Dock="Left" Content="{l:Loc s3connections.edit}" MinWidth="96" Margin="8,0,0,0" Command="{Binding EditCommand}"
                    AutomationProperties.Name="{l:Loc s3connections.edit}" />
            <Button DockPanel.Dock="Left" Content="{l:Loc s3connections.delete}" MinWidth="96" Margin="8,0,0,0" Command="{Binding DeleteCommand}"
                    AutomationProperties.Name="{l:Loc s3connections.delete}" />
            <Button DockPanel.Dock="Right" Content="{l:Loc common.close}" MinWidth="80" IsCancel="True"
                    AutomationProperties.Name="{l:Loc common.close}" />
        </DockPanel>
    </StackPanel>
</Window>
