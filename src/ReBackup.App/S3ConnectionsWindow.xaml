<Window x:Class="ReBackup.App.S3ConnectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ReBackup.Shared.Wpf.Localization;assembly=ReBackup.Shared.Wpf"
        xmlns:conn="clr-namespace:ReBackup.Storage.S3.Connections;assembly=ReBackup.Storage.S3"
        Title="{l:Loc s3connections.title}" Width="660" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}">
    <!-- The S3 connections of the configuration folder: add, edit (double-click), delete. Every change is stored at once. -->
    <StackPanel Margin="20,18">
        <TextBlock Style="{StaticResource TextBlock.Muted}" Margin="0,0,0,12" FontSize="12" TextWrapping="Wrap"
                   Text="{l:Loc s3connections.note}" />
        <Border Style="{StaticResource Border.Card}" Padding="0">
            <Grid>
                <ListView x:Name="ConnectionList" Style="{StaticResource ListView.Table}" SelectionMode="Single" MinHeight="160" MaxHeight="360"
                          ItemsSource="{Binding Connections}" SelectedItem="{Binding Selected}" MouseDoubleClick="OnRowDoubleClick"
                          AutomationProperties.Name="{l:Loc s3connections.title}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{l:Loc common.name}" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type conn:S3ConnectionInfo}">
                                        <TextBlock Margin="8,0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{l:Loc s3connections.column.bucket}" Width="230">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type conn:S3ConnectionInfo}">
                                        <TextBlock Margin="8,0" Style="{StaticResource TextBlock.Mono}" Text="{Binding Bucket}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{l:Loc s3connections.column.region}" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type conn:S3ConnectionInfo}">
                                        <TextBlock Margin="8,0" Style="{StaticResource TextBlock.Muted}" Text="{Binding Region}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- No connections yet -->
                <TextBlock Style="{StaticResource TextBlock.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False" Text="{l:Loc s3connections.empty}">
                    <TextBlock.Visibility>
                        <Binding Path="IsEmpty">
                            <Binding.Converter>
                                <BooleanToVisibilityConverter />
                            </Binding.Converter>
                        </Binding>
                    </TextBlock.Visibility>
                </TextBlock>

                <!-- The file cannot be read; it is left as it is -->
                <TextBlock Margin="16,0" Foreground="{DynamicResource Brush.Danger}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" IsHitTestVisible="False" Text="{Binding LoadError}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LoadError}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <DockPanel Margin="0,18,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="{l:Loc s3connections.add}" MinWidth="96" Command="{Binding AddCommand}"
                    AutomationProperties.Name="{l:Loc s3connections.add}" />
            <Button DockPanel.Dock="Left" Content="{l:Loc s3connections.edit}" MinWidth="96" Margin="8,0,0,0" Command="{Binding EditCommand}"
                    AutomationProperties.Name="{l:Loc s3connections.edit}" />
            <Button DockPanel.Dock="Left" Content="{l:Loc s3connections.delete}" MinWidth="96" Margin="8,0,0,0" Command="{Binding DeleteCommand}"
                    AutomationProperties.Name="{l:Loc s3connections.delete}" />
            <Button DockPanel.Dock="Right" Content="{l:Loc common.close}" MinWidth="80" IsCancel="True"
                    AutomationProperties.Name="{l:Loc common.close}" />
        </DockPanel>
    </StackPanel>
</Window>
