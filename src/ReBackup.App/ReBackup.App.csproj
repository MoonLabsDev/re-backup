<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ReBackup.Core\ReBackup.Core.csproj" />
    <ProjectReference Include="..\ReBackup.Shared\ReBackup.Shared.csproj" />
    <ProjectReference Include="..\ReBackup.Shared.Wpf\ReBackup.Shared.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\..\assets\branding\rebackup.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\branding\rebackup.ico" Link="Assets\rebackup.ico" />
    <Resource Include="..\..\assets\branding\rebackup-256.png" Link="Assets\rebackup-256.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- The label files; Loc reads them as ReBackup.App.Locales.<language>.json. -->
    <EmbeddedResource Include="Locales\*.json" LogicalName="ReBackup.App.Locales.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
