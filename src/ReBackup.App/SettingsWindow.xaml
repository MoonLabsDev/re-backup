<Window x:Class="ReBackup.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ReBackup.Shared.Wpf.Localization;assembly=ReBackup.Shared.Wpf"
        xmlns:appl="clr-namespace:ReBackup.App.Localization"
        Title="{l:Loc settings.windowTitle}" Width="600" Height="1010" MinWidth="480" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}">
    <Grid Margin="20,16">
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="Converter.Visible" />
