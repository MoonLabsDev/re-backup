<Window x:Class="ReBackup.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ReBackup.App.Localization"
        Title="{l:Loc settings.windowTitle}" Width="600" Height="760" MinWidth="480" MinHeight="660"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Border.Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource TextBlock.CardTitle}" Margin="0,0,0,10" Text="{l:Loc settings.config.title}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{l:Loc settings.config.change}" Margin="8,0,0,0" Command="{Binding ChangeConfigFolderCommand}" />
                    <TextBox Style="{StaticResource TextBox.Code}" MinHeight="34" VerticalContentAlignment="Center"
                             Text="{Binding ConfigFolder, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="{l:Loc settings.config.name}" />
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Border.Card}" Margin="0,12,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource TextBlock.CardTitle}" Text="{l:Loc settings.ignore.title}" />
                    <TextBlock Style="{StaticResource TextBlock.Muted}" Margin="0,4,0,0" FontSize="12"
                               Text="{l:Loc settings.ignore.note}" />
                </StackPanel>
                <TextBox AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Style="{StaticResource TextBox.Code}"
                         AutomationProperties.Name="{l:Loc settings.ignore.name}"
                         Text="{Binding DefaultIgnorePatterns, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Border.Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource TextBlock.CardTitle}" Margin="0,0,0,12" Text="{l:Loc settings.app.title}" />
                <CheckBox Style="{StaticResource CheckBox.Switch}" IsChecked="{Binding CloseToTray}">
                    <TextBlock TextWrapping="Wrap" Text="{l:Loc settings.app.closeToTray}" />
                </CheckBox>
                <CheckBox Style="{StaticResource CheckBox.Switch}" Margin="0,10,0,0" IsChecked="{Binding StartWithWindows}">
                    <TextBlock TextWrapping="Wrap" Text="{l:Loc settings.app.startWithWindows}" />
                </CheckBox>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Border.Card}" Margin="0,12,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Right" VerticalAlignment="Center" Padding="3" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                        AutomationProperties.Name="{l:Loc settings.theme.name}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource RadioButton.Segment}" GroupName="Theme" Content="{l:Loc enum.theme.Dark}"
                                     Margin="2,0,0,0" IsChecked="{Binding IsDarkTheme}" />
                        <RadioButton Style="{StaticResource RadioButton.Segment}" GroupName="Theme" Content="{l:Loc enum.theme.Light}"
                                     Margin="2,0,0,0" IsChecked="{Binding IsLightTheme}" />
                    </StackPanel>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource TextBlock.CardTitle}" Text="{l:Loc settings.theme.title}" />
                    <TextBlock Style="{StaticResource TextBlock.Muted}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                               Text="{l:Loc settings.theme.note}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Border.Card}" Margin="0,12,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Right" VerticalAlignment="Center" Padding="3" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                        AutomationProperties.Name="{l:Loc settings.language.name}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource RadioButton.Segment}" GroupName="Language" Margin="2,0,0,0"
                                     IsChecked="{Binding IsGerman}" AutomationProperties.Name="{l:Loc language.de-DE}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Border.Flag}">
                                    <Image Style="{StaticResource Image.Flag}" Width="18" Height="12" Source="{StaticResource Flag.DE}" />
                                </Border>
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{l:Loc language.de-DE}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource RadioButton.Segment}" GroupName="Language" Margin="2,0,0,0"
                                     IsChecked="{Binding IsEnglish}" AutomationProperties.Name="{l:Loc language.en-US}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Border.Flag}">
                                    <Image Style="{StaticResource Image.Flag}" Width="18" Height="12" Source="{StaticResource Flag.GB}" />
                                </Border>
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{l:Loc language.en-US}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource TextBlock.CardTitle}" Text="{l:Loc settings.language.title}" />
                    <TextBlock Style="{StaticResource TextBlock.Muted}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                               Text="{l:Loc settings.language.note}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="5" Margin="0,16,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TextBlock.Muted}" FontSize="12" Text="{l:LocVersion}" />
                <!-- Copyright with a link to the company's site. -->
                <TextBlock Style="{StaticResource TextBlock.Muted}" Margin="0,2,0,0" FontSize="12">
                    <Run Text="{l:Loc app.copyright}" />
                    <Hyperlink NavigateUri="https://moon-labs.io" RequestNavigate="OnCompanyLinkClicked"
                               Foreground="{DynamicResource Brush.AccentLight}"
                               ToolTip="{Binding NavigateUri, RelativeSource={RelativeSource Self}}">
                        <Run Text="{l:Loc app.company}" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="{l:Loc common.cancel}" MinWidth="84" IsCancel="True" Command="{Binding CancelCommand}" />
            <Button Style="{StaticResource Button.Accent}" Content="{l:Loc common.ok}" MinWidth="84" Margin="8,0,0,0" IsDefault="True"
                    Command="{Binding SaveCommand}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
