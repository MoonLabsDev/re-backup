            <Geometry x:Key="Logo.OpenAI">M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7475-7.0729zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944zm-9.6607-4.1254a4.4708 4.4708 0 0 1-.5346-3.0137l.142.0852 4.783 2.7582a.7712.7712 0 0 0 .7806 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 19.9502a4.4992 4.4992 0 0 1-6.1408-1.6464zM2.3408 7.8956a4.485 4.485 0 0 1 2.3655-1.9728V11.6a.7664.7664 0 0 0 .3879.6765l5.8144 3.3543-2.0201 1.1685a.0757.0757 0 0 1-.071 0l-4.8303-2.7865A4.504 4.504 0 0 1 2.3408 7.872zm16.5963 3.8558L13.1038 8.364 15.1192 7.2a.0757.0757 0 0 1 .071 0l4.8303 2.7913a4.4944 4.4944 0 0 1-.6765 8.1042v-5.6772a.79.79 0 0 0-.407-.667zm2.0107-3.0231l-.142-.0852-4.7735-2.7818a.7759.7759 0 0 0-.7854 0L9.409 9.2297V6.8974a.0662.0662 0 0 1 .0284-.0615l4.8303-2.7866a4.4992 4.4992 0 0 1 6.6802 4.66zM8.3065 12.863l-2.02-1.1638a.0804.0804 0 0 1-.038-.0567V6.0742a4.4992 4.4992 0 0 1 7.3757-3.4537l-.142.0805L8.704 5.459a.7948.7948 0 0 0-.3927.6813zm1.0976-2.3654l2.602-1.4998 2.6069 1.4998v2.9994l-2.5974 1.4997-2.6067-1.4997Z</Geometry>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The cards scroll when the window is lower than they are; the buttons below always stay in view. The inner grid is
             at least as high as the view, so in a large window the ignore patterns take the space that is left. -->
        <ScrollViewer x:Name="ContentScroller" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="160" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Border.Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource TextBlock.CardTitle}" Margin="0,0,0,10" Text="{l:Loc settings.config.title}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{l:Loc settings.config.change}" Margin="8,0,0,0" Command="{Binding ChangeConfigFolderCommand}" />
                    <TextBox Style="{StaticResource TextBox.Code}" MinHeight="34" VerticalContentAlignment="Center"
                             Text="{Binding ConfigFolder, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="{l:Loc settings.config.name}" />
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Border.Card}" Margin="0,12,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource TextBlock.CardTitle}" Text="{l:Loc settings.ignore.title}" />
                    <TextBlock Style="{StaticResource TextBlock.Muted}" Margin="0,4,0,0" FontSize="12"
                               Text="{l:Loc settings.ignore.note}" />
                </StackPanel>
                <TextBox AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Style="{StaticResource TextBox.Code}"
                         AutomationProperties.Name="{l:Loc settings.ignore.name}"
                         Text="{Binding DefaultIgnorePatterns, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="2">
            <!-- S3: the accounts (access keys) and the connections (bucket + account) plans can use; stored at once. -->
            <Border Style="{StaticResource Border.Card}" Margin="0,12,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{l:Loc settings.s3.accounts}" Command="{Binding ManageS3AccountsCommand}"
                                AutomationProperties.Name="{l:Loc settings.s3.accounts}" />
                        <Button Margin="8,0,0,0" Content="{l:Loc settings.s3.connections}" Command="{Binding ManageS3ConnectionsCommand}"
                                AutomationProperties.Name="{l:Loc settings.s3.connections}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource TextBlock.CardTitle}" Text="{l:Loc settings.s3.title}" />
                        <TextBlock Style="{StaticResource TextBlock.Muted}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                   Text="{l:Loc settings.s3.note}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- Google Drive: the service accounts (key files) and the connections (shared drive or folder + account); stored at once. -->
            <Border Style="{StaticResource Border.Card}" Margin="0,12,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{l:Loc settings.drive.accounts}" Command="{Binding ManageDriveAccountsCommand}"
                                AutomationProperties.Name="{l:Loc settings.drive.accounts}" />
                        <Button Margin="8,0,0,0" Content="{l:Loc settings.drive.connections}" Command="{Binding ManageDriveConnectionsCommand}"
                                AutomationProperties.Name="{l:Loc settings.drive.connections}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource TextBlock.CardTitle}" Text="{l:Loc settings.drive.title}" />
                        <TextBlock Style="{StaticResource TextBlock.Muted}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                   Text="{l:Loc settings.drive.note}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource Border.Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource TextBlock.CardTitle}" Margin="0,0,0,12" Text="{l:Loc settings.app.title}" />
                <CheckBox Style="{StaticResource CheckBox.Switch}" IsChecked="{Binding CloseToTray}">
                    <TextBlock TextWrapping="Wrap" Text="{l:Loc settings.app.closeToTray}" />
                </CheckBox>
                <CheckBox Style="{StaticResource CheckBox.Switch}" Margin="0,10,0,0" IsChecked="{Binding StartWithWindows}">
                    <TextBlock TextWrapping="Wrap" Text="{l:Loc settings.app.startWithWindows}" />
                </CheckBox>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Border.Card}" Margin="0,12,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="{l:Loc settings.mcp.copy}" Command="{Binding CopyMcpConfigurationCommand}"
                            AutomationProperties.Name="{l:Loc settings.mcp.copy}" />
                    <TextBlock Style="{StaticResource TextBlock.Muted}" Margin="0,4,0,0" FontSize="12" HorizontalAlignment="Center"
                               Text="{l:Loc settings.mcp.copied}" Visibility="{Binding McpCopied, Converter={StaticResource Converter.Visible}}" />
                    <!-- Register this exe with a client's command line tool (removes an older registration first). -->
                    <Button Margin="0,8,0,0" HorizontalContentAlignment="Left" Command="{Binding RegisterClaudeCodeCommand}"
                            ToolTip="{l:Loc settings.mcp.registerClaudeToolTip}" AutomationProperties.Name="{l:Loc settings.mcp.registerClaude}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Stretch="Uniform" Fill="#D97757" Data="{StaticResource Logo.Claude}" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{l:Loc settings.mcp.registerClaude}" />
                        </StackPanel>
                    </Button>
                    <Button Margin="0,6,0,0" HorizontalContentAlignment="Left" Command="{Binding RegisterCodexCommand}"
                            ToolTip="{l:Loc settings.mcp.registerCodexToolTip}" AutomationProperties.Name="{l:Loc settings.mcp.registerCodex}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource Logo.OpenAI}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{l:Loc settings.mcp.registerCodex}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TextBlock.CardTitle}" Margin="0,0,0,10" Text="{l:Loc settings.mcp.title}" />
                    <CheckBox Style="{StaticResource CheckBox.Switch}" IsChecked="{Binding AllowMcpControl}">
                        <TextBlock TextWrapping="Wrap" Text="{l:Loc settings.mcp.allow}" />
                    </CheckBox>
                    <TextBlock Style="{StaticResource TextBlock.Muted}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                               Text="{l:Loc settings.mcp.allowHint}" />
                    <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding McpRegisterText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Muted}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding McpRegisterText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding McpRegisterFailed}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="5" Style="{StaticResource Border.Card}" Margin="0,12,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Right" VerticalAlignment="Center" Padding="3" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                        AutomationProperties.Name="{l:Loc settings.theme.name}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource RadioButton.Segment}" GroupName="Theme" Content="{l:Loc enum.theme.Dark}"
                                     Margin="2,0,0,0" IsChecked="{Binding IsDarkTheme}" />
                        <RadioButton Style="{StaticResource RadioButton.Segment}" GroupName="Theme" Content="{l:Loc enum.theme.Light}"
                                     Margin="2,0,0,0" IsChecked="{Binding IsLightTheme}" />
                    </StackPanel>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource TextBlock.CardTitle}" Text="{l:Loc settings.theme.title}" />
                    <TextBlock Style="{StaticResource TextBlock.Muted}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                               Text="{l:Loc settings.theme.note}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="6" Style="{StaticResource Border.Card}" Margin="0,12,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Right" VerticalAlignment="Center" Padding="3" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                        AutomationProperties.Name="{l:Loc settings.language.name}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource RadioButton.Segment}" GroupName="Language" Margin="2,0,0,0"
                                     IsChecked="{Binding IsGerman}" AutomationProperties.Name="{l:Loc language.de-DE}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Border.Flag}">
                                    <Image Style="{StaticResource Image.Flag}" Width="18" Height="12" Source="{StaticResource Flag.DE}" />
                                </Border>
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{l:Loc language.de-DE}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource RadioButton.Segment}" GroupName="Language" Margin="2,0,0,0"
                                     IsChecked="{Binding IsEnglish}" AutomationProperties.Name="{l:Loc language.en-US}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Border.Flag}">
                                    <Image Style="{StaticResource Image.Flag}" Width="18" Height="12" Source="{StaticResource Flag.GB}" />
                                </Border>
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{l:Loc language.en-US}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource TextBlock.CardTitle}" Text="{l:Loc settings.language.title}" />
                    <TextBlock Style="{StaticResource TextBlock.Muted}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                               Text="{l:Loc settings.language.note}" />
                </StackPanel>
            </DockPanel>
        </Border>

        </Grid>
        </ScrollViewer>

        <DockPanel x:Name="ButtonRow" Grid.Row="1" Margin="0,16,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TextBlock.Muted}" FontSize="12" Text="{appl:LocVersion}" />
                <!-- Copyright with a link to the company's site. -->
                <TextBlock Style="{StaticResource TextBlock.Muted}" Margin="0,2,0,0" FontSize="12">
                    <Run Text="{l:Loc app.copyright}" />
                    <Hyperlink NavigateUri="https://moon-labs.io" RequestNavigate="OnCompanyLinkClicked"
                               Foreground="{DynamicResource Brush.AccentLight}"
                               ToolTip="{Binding NavigateUri, RelativeSource={RelativeSource Self}}">
                        <Run Text="{l:Loc app.company}" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="{l:Loc common.cancel}" MinWidth="84" IsCancel="True" Command="{Binding CancelCommand}" />
            <Button Style="{StaticResource Button.Accent}" Content="{l:Loc common.ok}" MinWidth="84" Margin="8,0,0,0" IsDefault="True"
                    Command="{Binding SaveCommand}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
