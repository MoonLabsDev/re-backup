<Window x:Class="ReBackup.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReBackup settings" Width="600" Height="700" MinWidth="480" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Border.Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource TextBlock.CardTitle}" Margin="0,0,0,10" Text="CONFIGURATION FOLDER" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Change…" Margin="8,0,0,0" Command="{Binding ChangeConfigFolderCommand}" />
                    <TextBox Style="{StaticResource TextBox.Code}" MinHeight="34" VerticalContentAlignment="Center"
                             Text="{Binding ConfigFolder, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Configuration folder" />
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Border.Card}" Margin="0,12,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource TextBlock.CardTitle}" Text="DEFAULT IGNORE PATTERNS" />
                    <TextBlock Style="{StaticResource TextBlock.Muted}" Margin="0,4,0,0" FontSize="12"
                               Text="One per line, gitignore syntax." />
                </StackPanel>
                <TextBox AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Style="{StaticResource TextBox.Code}"
                         AutomationProperties.Name="Default ignore patterns"
                         Text="{Binding DefaultIgnorePatterns, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Border.Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource TextBlock.CardTitle}" Margin="0,0,0,12" Text="APP" />
                <CheckBox Style="{StaticResource CheckBox.Switch}" IsChecked="{Binding CloseToTray}">
                    <TextBlock TextWrapping="Wrap" Text="Closing the window minimizes to the tray" />
                </CheckBox>
                <CheckBox Style="{StaticResource CheckBox.Switch}" Margin="0,10,0,0" IsChecked="{Binding StartWithWindows}">
                    <TextBlock TextWrapping="Wrap" Text="Start with Windows (minimized to tray)" />
                </CheckBox>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Border.Card}" Margin="0,12,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Right" VerticalAlignment="Center" Padding="3" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                        AutomationProperties.Name="Theme">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource RadioButton.Segment}" GroupName="Theme" Content="System"
                                     ToolTip="Follow the Windows app mode" IsChecked="{Binding IsSystemTheme}" />
                        <RadioButton Style="{StaticResource RadioButton.Segment}" GroupName="Theme" Content="Dark"
                                     Margin="2,0,0,0" IsChecked="{Binding IsDarkTheme}" />
                        <RadioButton Style="{StaticResource RadioButton.Segment}" GroupName="Theme" Content="Light"
                                     Margin="2,0,0,0" IsChecked="{Binding IsLightTheme}" />
                    </StackPanel>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource TextBlock.CardTitle}" Text="THEME" />
                    <TextBlock Style="{StaticResource TextBlock.Muted}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                               Text="Applies at once." />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" MinWidth="84" IsCancel="True" Command="{Binding CancelCommand}" />
            <Button Style="{StaticResource Button.Accent}" Content="OK" MinWidth="84" Margin="8,0,0,0" IsDefault="True"
                    Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</Window>
