<!--
    Dark Pro design tokens, the light palette. One Color and one frozen SolidColorBrush per token.
    Views use only the Brush.<Token> keys; the derived brushes at the end are for the control templates
    in Controls.xaml, the chart palette for the drawing controls (treemap, retention timeline).
    Colors.Dark.xaml has exactly the same keys: ThemeManager swaps the two as a whole, so every use outside the
    palettes must be a DynamicResource (code that draws itself re-reads the colours on ThemeManager.ThemeChanged).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!-- Tokens -->
    <Color x:Key="Color.Bg">#F5F6F8</Color>
    <Color x:Key="Color.Rail">#ECEEF2</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.Card">#FFFFFF</Color>
    <Color x:Key="Color.Raised">#F0F2F5</Color>
    <Color x:Key="Color.Border">#E2E5EA</Color>
    <Color x:Key="Color.BorderStrong">#CDD2D9</Color>
    <Color x:Key="Color.Text">#1B1F24</Color>
    <Color x:Key="Color.TextMuted">#5B6573</Color>
    <Color x:Key="Color.TextFaint">#8B95A3</Color>
    <Color x:Key="Color.Accent">#1F8A7E</Color>
    <Color x:Key="Color.AccentHover">#187468</Color>
    <Color x:Key="Color.AccentText">#FFFFFF</Color>
    <Color x:Key="Color.AccentSoft">#DDF3EF</Color>
    <Color x:Key="Color.AccentLight">#136F65</Color>
    <Color x:Key="Color.Selection">#D7EFEB</Color>
    <Color x:Key="Color.Danger">#D1343B</Color>
    <Color x:Key="Color.Warning">#B07D00</Color>
    <Color x:Key="Color.PartialRow">#FFF6D8</Color>
    <Color x:Key="Color.IgnoredRow">#FBE3E1</Color>

    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Rail" Color="{StaticResource Color.Rail}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Raised" Color="{StaticResource Color.Raised}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextFaint" Color="{StaticResource Color.TextFaint}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource Color.AccentText}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentLight" Color="{StaticResource Color.AccentLight}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Selection" Color="{StaticResource Color.Selection}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.PartialRow" Color="{StaticResource Color.PartialRow}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.IgnoredRow" Color="{StaticResource Color.IgnoredRow}" po:Freeze="True" />

    <!-- Derived shades, used only inside the control templates (hover/pressed states). -->
    <SolidColorBrush x:Key="Brush.RaisedHover" Color="#E6E9EE" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.RaisedPressed" Color="#DCE0E6" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.BorderHover" Color="#AEB6C1" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#135F56" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FCE9E8" po:Freeze="True" />

    <!-- Chart palette (treemap, retention timeline): families of a light and a dark shade, plus the ignored tile.
         Darker and more saturated than the dark theme's, so the tiles and markers read on white. -->
    <Color x:Key="Color.Chart.TealLight">#2BA595</Color>
    <Color x:Key="Color.Chart.Teal">#1F8A7E</Color>
    <Color x:Key="Color.Chart.TealDark">#136F65</Color>
    <Color x:Key="Color.Chart.BlueLight">#4A8BE6</Color>
    <Color x:Key="Color.Chart.BlueDark">#2A62B8</Color>
    <Color x:Key="Color.Chart.VioletLight">#9B6FE6</Color>
    <Color x:Key="Color.Chart.VioletDark">#6F44C0</Color>
    <Color x:Key="Color.Chart.AmberLight">#E39B1E</Color>
    <Color x:Key="Color.Chart.AmberDark">#B5710C</Color>
    <Color x:Key="Color.Chart.Ignored">#D5DAE1</Color>

    <!-- Fill of the "% of parent" bars in the ignore preview; the bar's text (Brush.Text) sits on it, so here a light
         teal instead of the dark chart shade. -->
    <SolidColorBrush x:Key="Brush.PercentFill" Color="#B5E4DC" po:Freeze="True" />

</ResourceDictionary>
