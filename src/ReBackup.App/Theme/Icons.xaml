<!--
    Icon glyphs of "Segoe Fluent Icons, Segoe MDL2 Assets" (Font.Icon). Show them with TextBlock.Icon or Button.Icon:
    <TextBlock Style="{StaticResource TextBlock.Icon}" Text="{StaticResource Icon.Play}" />
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="Icon.Play">&#xE768;</sys:String>
    <sys:String x:Key="Icon.Stop">&#xE71A;</sys:String>
    <sys:String x:Key="Icon.Add">&#xE710;</sys:String>
    <sys:String x:Key="Icon.Delete">&#xE74D;</sys:String>
    <sys:String x:Key="Icon.OpenFolder">&#xE838;</sys:String>
    <sys:String x:Key="Icon.Save">&#xE74E;</sys:String>
    <sys:String x:Key="Icon.Undo">&#xE7A7;</sys:String>
    <sys:String x:Key="Icon.Refresh">&#xE72C;</sys:String>
    <sys:String x:Key="Icon.Settings">&#xE713;</sys:String>
    <sys:String x:Key="Icon.Clock">&#xE823;</sys:String>
    <sys:String x:Key="Icon.Calendar">&#xE787;</sys:String>
    <sys:String x:Key="Icon.History">&#xE81C;</sys:String>
    <sys:String x:Key="Icon.Shield">&#xEA18;</sys:String>
    <sys:String x:Key="Icon.Hide">&#xED1A;</sys:String>
    <sys:String x:Key="Icon.Edit">&#xE70F;</sys:String>
    <sys:String x:Key="Icon.Cancel">&#xE711;</sys:String>
    <sys:String x:Key="Icon.ChevronDown">&#xE70D;</sys:String>
    <sys:String x:Key="Icon.Plan">&#xE8F1;</sys:String>
    <sys:String x:Key="Icon.ThemeDark">&#xE708;</sys:String>
    <sys:String x:Key="Icon.ThemeLight">&#xE706;</sys:String>
    <sys:String x:Key="Icon.Pause">&#xE769;</sys:String>
    <sys:String x:Key="Icon.Power">&#xE7E8;</sys:String>
    <sys:String x:Key="Icon.Versions">&#xE81E;</sys:String>
    <sys:String x:Key="Icon.Search">&#xE721;</sys:String>
    <sys:String x:Key="Icon.Swap">&#xE8AB;</sys:String>
    <sys:String x:Key="Icon.Document">&#xE8A5;</sys:String>
    <sys:String x:Key="Icon.Folder">&#xE8B7;</sys:String>
    <sys:String x:Key="Icon.OpenFile">&#xE8E5;</sys:String>
    <sys:String x:Key="Icon.Explorer">&#xEC50;</sys:String>
    <sys:String x:Key="Icon.Restore">&#xE777;</sys:String>
    <sys:String x:Key="Icon.Warning">&#xE7BA;</sys:String>

    <!-- Used by the control templates. -->
    <sys:String x:Key="Icon.ChevronUp">&#xE70E;</sys:String>
    <sys:String x:Key="Icon.ChevronRight">&#xE76C;</sys:String>
    <sys:String x:Key="Icon.CheckMark">&#xE73E;</sys:String>
    <!-- Colored classic folder (back flap + front), amber; WPF cannot render color emoji. Show it with
         <Image Style="{StaticResource Image.FolderColored}" />; it greys out with its disabled parent button. -->
    <DrawingImage x:Key="Icon.FolderColored">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#D9932B" Geometry="M0.5,2 Q0.5,1 1.5,1 H5.5 L7,2.5 H14.5 Q15.5,2.5 15.5,3.5 V12.5 Q15.5,13.5 14.5,13.5 H1.5 Q0.5,13.5 0.5,12.5 Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#8C5A12" Thickness="0.6" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#F2B84B" Geometry="M0.5,6 Q0.5,5 1.5,5 H14.5 Q15.5,5 15.5,6 V12.5 Q15.5,13.5 14.5,13.5 H1.5 Q0.5,13.5 0.5,12.5 Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#8C5A12" Thickness="0.6" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#40FFFFFF" Geometry="M1.2,6.1 H14.8" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <Style x:Key="Image.FolderColored" TargetType="Image">
        <Setter Property="Source" Value="{StaticResource Icon.FolderColored}" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
