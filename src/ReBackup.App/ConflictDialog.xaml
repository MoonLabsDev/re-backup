<Window x:Class="ReBackup.App.ConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ReBackup.Shared.Wpf.Localization;assembly=ReBackup.Shared.Wpf"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}">
    <!-- Asked once per restore: what happens to files that exist at the destination. -->
    <StackPanel Margin="20,18">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13" />
        <TextBlock Style="{StaticResource TextBlock.Muted}" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                   Text="{l:Loc dialog.conflict.note}" />

        <!-- Parts of the version that cannot be read (their files are not restored); hidden when there are none. -->
        <StackPanel x:Name="DetailsPanel" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock x:Name="DetailsTitle" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Warning}" />
            <TextBox x:Name="DetailsText" Style="{StaticResource TextBox.Code}" Margin="0,6,0,0" MaxHeight="140"
                     IsReadOnly="True" TextWrapping="NoWrap" AutomationProperties.Name="{l:Loc dialog.conflict.detailsName}"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </StackPanel>

        <StackPanel Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{l:Loc dialog.conflict.overwrite}" MinWidth="96" Click="OnOverwrite" AutomationProperties.Name="{l:Loc dialog.conflict.overwrite}"
                    ToolTip="{l:Loc dialog.conflict.overwriteToolTip}" />
            <Button Content="{l:Loc dialog.conflict.skip}" MinWidth="80" Margin="8,0,0,0" Click="OnSkip" AutomationProperties.Name="{l:Loc dialog.conflict.skip}"
                    ToolTip="{l:Loc dialog.conflict.skipToolTip}" />
            <Button Content="{l:Loc dialog.conflict.keepBoth}" MinWidth="96" Margin="8,0,0,0" Style="{StaticResource Button.Accent}" IsDefault="True"
                    Click="OnKeepBoth" AutomationProperties.Name="{l:Loc dialog.conflict.keepBoth}" />
            <Button Content="{l:Loc common.cancel}" MinWidth="80" Margin="8,0,0,0" IsCancel="True" AutomationProperties.Name="{l:Loc common.cancel}" />
        </StackPanel>
    </StackPanel>
</Window>
