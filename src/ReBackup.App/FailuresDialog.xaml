<Window x:Class="ReBackup.App.FailuresDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ReBackup.Shared.Wpf.Localization;assembly=ReBackup.Shared.Wpf"
        Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}">
    <!-- What a restore could not do (or, before it starts, cannot read): a message and the list, which can be copied. -->
    <StackPanel Margin="20,18">
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TextBlock.Icon}" VerticalAlignment="Top" Margin="0,1,12,0"
                       FontSize="18" Foreground="{DynamicResource Brush.Warning}" Text="{StaticResource Icon.Warning}" />
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13" />
        </DockPanel>
        <TextBox x:Name="LinesText" Style="{StaticResource TextBox.Code}" Margin="0,14,0,0" MinHeight="80" MaxHeight="260"
                 IsReadOnly="True" TextWrapping="NoWrap" AutomationProperties.Name="{l:Loc dialog.failures.linesName}"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        <StackPanel Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ConfirmButton" MinWidth="96" Style="{StaticResource Button.Accent}"
                    Click="OnConfirm" Visibility="Collapsed" />
            <Button x:Name="CloseButton" Content="{l:Loc common.close}" MinWidth="80" Margin="8,0,0,0" IsCancel="True" IsDefault="True"
                    AutomationProperties.Name="{l:Loc common.close}" />
        </StackPanel>
    </StackPanel>
</Window>
