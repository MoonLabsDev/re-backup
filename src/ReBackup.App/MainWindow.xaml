<Window x:Class="ReBackup.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ReBackup.App.Views"
        Title="ReBackup" Width="1280" Height="800" MinWidth="960" MinHeight="560"
        Style="{StaticResource {x:Type Window}}">
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Small glyph button with a frame (New plan, Cancel in a plan card). -->
        <Style x:Key="Button.IconFramed" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Icon}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <!-- Small accent glyph button (Run now in a plan card). -->
        <Style x:Key="Button.AccentIcon" TargetType="Button" BasedOn="{StaticResource Button.Accent}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Icon}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <!-- Status dot of a plan: Accent while queued/running, Danger after a failed or canceled run,
             Warning after a run with warnings, otherwise faint. -->
        <Style x:Key="Ellipse.PlanDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource Brush.TextFaint}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Run.Dot}" Value="Active">
                    <Setter Property="Fill" Value="{StaticResource Brush.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Run.Dot}" Value="Failed">
                    <Setter Property="Fill" Value="{StaticResource Brush.Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Run.Dot}" Value="Warning">
                    <Setter Property="Fill" Value="{StaticResource Brush.Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Shown only while the plan of the DataContext is queued or running. -->
        <Style x:Key="Panel.WhileActive" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Run.IsActive}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A plan in the list: a card; the selected one gets an accent border. -->
        <Style x:Key="ListBoxItem.PlanCard" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="8,0,8,6" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Card}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Raised}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================ Icon rail -->
        <Border Grid.Column="0" Background="{StaticResource Brush.Rail}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="0,14">
                <Border DockPanel.Dock="Top" Width="34" Height="34" CornerRadius="9" HorizontalAlignment="Center"
                        Background="{StaticResource Brush.Accent}">
                    <TextBlock Text="Re:" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Brush.AccentText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Button DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Style="{StaticResource Button.Icon}"
                        Width="40" Height="40" FontSize="18" Content="{StaticResource Icon.Settings}"
                        ToolTip="Settings" AutomationProperties.Name="Settings"
                        Command="{Binding OpenSettingsCommand}" />
            </DockPanel>
        </Border>

        <!-- ============================================================ Plan list -->
        <Border Grid.Column="1" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="14,16,14,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.IconFramed}" Content="{StaticResource Icon.Add}"
                            ToolTip="New plan" AutomationProperties.Name="New plan" Command="{Binding NewPlanCommand}" />
                    <TextBlock Style="{StaticResource TextBlock.CardTitle}" FontSize="11" VerticalAlignment="Center"
                               Text="PLANS" />
                </DockPanel>

                <Button DockPanel.Dock="Bottom" HorizontalAlignment="Stretch" Margin="8,6,8,10"
                        AutomationProperties.Name="Delete plan" Command="{Binding DeletePlanCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextBlock.Icon}" FontSize="13" Foreground="{StaticResource Brush.Danger}"
                                   Text="{StaticResource Icon.Delete}" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Delete plan" />
                    </StackPanel>
                </Button>

                <ListBox ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}"
                         ItemContainerStyle="{StaticResource ListBoxItem.PlanCard}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Plans">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <!-- Dot, name, Run now / Cancel -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Style="{StaticResource Ellipse.PlanDot}" />
                                    <TextBlock Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center"
                                               Text="{Binding DisplayName}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <Grid Grid.Column="2">
                                        <Button Content="{StaticResource Icon.Play}"
                                                ToolTip="Run now" AutomationProperties.Name="Run now"
                                                Command="{Binding DataContext.RunNowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Button.AccentIcon}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Run.IsActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{StaticResource Icon.Stop}"
                                                ToolTip="Cancel the backup" AutomationProperties.Name="Cancel the backup"
                                                Command="{Binding DataContext.CancelRunCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Button.IconFramed}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Run.IsActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Grid>

                                <!-- Progress while queued or running. The remaining time has its own line and is never trimmed. -->
                                <StackPanel Margin="0,8,0,0" Style="{StaticResource Panel.WhileActive}">
                                    <ProgressBar Maximum="100" Value="{Binding Run.ProgressPercent, Mode=OneWay}"
                                                 IsIndeterminate="{Binding Run.IsIndeterminate}" />
                                    <TextBlock Margin="0,5,0,0" FontSize="12" Text="{Binding Run.ProgressText}"
                                               ToolTip="{Binding Run.ProgressText}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,2,0,0" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{StaticResource Brush.AccentLight}" Text="{Binding Run.EtaText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Run.EtaText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <TextBlock Margin="0,8,0,0" Style="{StaticResource TextBlock.Mono}"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           Text="{Binding Source}" ToolTip="{Binding Source}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource Brush.TextMuted}"
                                           Text="{Binding Run.LastRunText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="12" Foreground="{StaticResource Brush.TextMuted}"
                                           Text="{Binding Run.NextRunText}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Run.NextRunText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============================================================ Main area -->
        <DockPanel Grid.Column="2">
            <!-- Footer -->
            <Border DockPanel.Dock="Bottom" Height="34" Background="{StaticResource Brush.Rail}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="24,0">
                <DockPanel TextElement.FontSize="12" TextElement.Foreground="{StaticResource Brush.TextMuted}">
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                               Text="{Binding QueueStatus}" />
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                               Foreground="{StaticResource Brush.Warning}" Text="{Binding SchedulerStatus}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding StatusMessage}" ToolTip="{Binding StatusMessage}"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!-- No plan selected -->
            <Grid>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" Text="No plan selected. Create one with the + button next to PLANS.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Muted}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPlan}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <DockPanel DataContext="{Binding SelectedPlan}">
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>

                    <!-- Header: name, tabs, Revert / Save / Run now -->
                    <Border x:Name="HeaderBar" DockPanel.Dock="Top" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"
                            Padding="24,16" SizeChanged="OnHeaderSizeChanged">
                        <!-- One row when it fits; otherwise the tabs move below the name (MainWindow.LayoutHeader). -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="HeaderName" Grid.Column="0" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold"
                                       Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}"
                                       TextTrimming="CharacterEllipsis" />

                            <Border x:Name="MainTabsBar" Grid.Column="1" Margin="24,0,16,0" HorizontalAlignment="Left" Padding="3"
                                    Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1" CornerRadius="8">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="PlanTab" Style="{StaticResource RadioButton.Segment}" GroupName="MainTabs"
                                                 IsChecked="True" AutomationProperties.Name="Plan">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource TextBlock.Icon}" FontSize="13" Text="{StaticResource Icon.Plan}" />
                                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontWeight="Medium" Text="Plan" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="IgnoreTab" Style="{StaticResource RadioButton.Segment}" GroupName="MainTabs"
                                                 Margin="2,0,0,0" AutomationProperties.Name="Ignore">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource TextBlock.Icon}" FontSize="13" Text="{StaticResource Icon.Hide}" />
                                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontWeight="Medium" Text="Ignore" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="RetentionTab" Style="{StaticResource RadioButton.Segment}" GroupName="MainTabs"
                                                 Margin="2,0,0,0" AutomationProperties.Name="Retention">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource TextBlock.Icon}" FontSize="13" Text="{StaticResource Icon.Shield}" />
                                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontWeight="Medium" Text="Retention" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="HistoryTab" Style="{StaticResource RadioButton.Segment}" GroupName="MainTabs"
                                                 Margin="2,0,0,0" AutomationProperties.Name="History">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource TextBlock.Icon}" FontSize="13" Text="{StaticResource Icon.History}" />
                                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontWeight="Medium" Text="History" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="HeaderActions" Grid.Column="3" Orientation="Horizontal"
                                        SizeChanged="OnHeaderSizeChanged">
                                <Button Command="{Binding DataContext.RevertCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        IsEnabled="{Binding IsDirty, FallbackValue=False}" AutomationProperties.Name="Revert">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource TextBlock.Icon}" FontSize="13" Text="{StaticResource Icon.Undo}" />
                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Revert" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="8,0,0,0" ToolTip="Save (Ctrl+S)" AutomationProperties.Name="Save"
                                        Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        IsEnabled="{Binding IsDirty, FallbackValue=False}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource TextBlock.Icon}" FontSize="13" Text="{StaticResource Icon.Save}" />
                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Save" />
                                    </StackPanel>
                                </Button>
                                <Grid Margin="8,0,0,0">
                                    <Button AutomationProperties.Name="Run now"
                                            Command="{Binding DataContext.RunNowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Button.Accent}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Run.IsActive}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource TextBlock.Icon}" FontSize="12" Text="{StaticResource Icon.Play}" />
                                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Run now" />
                                        </StackPanel>
                                    </Button>
                                    <Button AutomationProperties.Name="Cancel the backup"
                                            Command="{Binding DataContext.CancelRunCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Run.IsActive}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource TextBlock.Icon}" FontSize="12" Text="{StaticResource Icon.Stop}" />
                                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Cancel" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Tab content: every view stays alive; only the chosen one is visible. -->
                    <Grid>
                        <views:PlanView Visibility="{Binding IsChecked, ElementName=PlanTab, Converter={StaticResource BoolToVisibility}}" />
                        <views:IgnorePreviewView
                                                 Visibility="{Binding IsChecked, ElementName=IgnoreTab, Converter={StaticResource BoolToVisibility}}" />
                        <views:RetentionView Margin="12,8"
                                             Visibility="{Binding IsChecked, ElementName=RetentionTab, Converter={StaticResource BoolToVisibility}}" />
                        <views:HistoryView Margin="12,8"
                                           Visibility="{Binding IsChecked, ElementName=HistoryTab, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
