<UserControl x:Class="ReBackup.App.Views.IgnorePreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ReBackup.App.Controls"
             xmlns:l="clr-namespace:ReBackup.App.Localization">
    <UserControl.Resources>
        <Style x:Key="TextBlock.Small" TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Muted}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Right-aligned number cell. -->
        <Style x:Key="TextBlock.Number" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <Style x:Key="Header.Number" TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Padding" Value="6,0,12,0" />
        </Style>

        <!-- The "In backup | Total" toggle: the chosen side in accent. -->
        <Style x:Key="RadioButton.Toggle" TargetType="RadioButton" BasedOn="{StaticResource RadioButton.Segment}">
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="12" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Border.Pill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="200" />
            <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- ======================================================== Patterns -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,1,0" Padding="14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextBlock.CardTitle}" Text="{l:Loc ignore.patterns.title}" />
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextBlock.Muted}" FontSize="12" Margin="0,4,0,10"
                           TextWrapping="Wrap" Text="{l:Loc ignore.patterns.syntax}" />
                <CheckBox DockPanel.Dock="Bottom" Style="{StaticResource CheckBox.Switch}" Margin="0,10,0,0"
                          IsChecked="{Binding HonorNestedIgnoreFiles}">
                    <TextBlock TextWrapping="Wrap" Text="{l:Loc ignore.patterns.nested}" />
                </CheckBox>
                <CheckBox DockPanel.Dock="Bottom" Style="{StaticResource CheckBox.Switch}" Margin="0,12,0,0"
                          IsChecked="{Binding UseGlobalIgnoreDefaults}">
                    <TextBlock TextWrapping="Wrap" Text="{l:Loc ignore.patterns.global}" />
                </CheckBox>
                <TextBox AcceptsReturn="True" Style="{StaticResource TextBox.Code}" AutomationProperties.Name="{l:Loc ignore.patterns.name}"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Text="{Binding IgnorePatternsText, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
        </Border>
        <GridSplitter Grid.Column="0" Width="5" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                      AutomationProperties.Name="{l:Loc ignore.patterns.resize}" />

        <!-- ======================================================== Preview -->
        <Grid Grid.Column="1" Margin="18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="12" />
                <RowDefinition Height="240" MinHeight="90" />
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource Button.Accent}" AutomationProperties.Name="{l:Loc ignore.index.now}"
                        ToolTip="{l:Loc ignore.index.toolTip}" Command="{Binding Preview.IndexCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextBlock.Icon}" FontSize="13" Text="{StaticResource Icon.Refresh}" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{l:Loc ignore.index.now}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Margin="8,0,0,0" AutomationProperties.Name="{l:Loc ignore.index.cancel}"
                        ToolTip="{l:Loc ignore.index.cancel}" Command="{Binding Preview.CancelIndexCommand}"
                        IsEnabled="{Binding Preview.IsIndexing}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextBlock.Icon}" FontSize="12" Text="{StaticResource Icon.Stop}" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{l:Loc common.cancel}" />
                    </StackPanel>
                </Button>
                <ProgressBar Grid.Column="2" Width="100" Margin="12,0,0,0" VerticalAlignment="Center"
                             IsIndeterminate="{Binding Preview.IsIndexing}" />
                <StackPanel Grid.Column="3" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TextBlock.Small}" Text="{Binding Preview.ProgressText}"
                               ToolTip="{Binding Preview.ProgressText}" />
                    <TextBlock Foreground="{DynamicResource Brush.Warning}" Text="{Binding Preview.PatternNote}"
                               ToolTip="{Binding Preview.PatternNote}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Small}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Preview.PatternNote}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1" Margin="0,10,0,0" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"
                       Text="{Binding Preview.Error}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Preview.Error}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Summary pills, with the size toggle on the right: always visible, also before the first scan. -->
            <DockPanel Grid.Row="2" Margin="0,12,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                    <TextBlock Style="{StaticResource TextBlock.Small}" Margin="0,0,8,0" Text="{l:Loc ignore.sizes.show}" />
                    <Border Background="{DynamicResource Brush.Rail}" BorderBrush="{DynamicResource Brush.BorderStrong}"
                            BorderThickness="1" CornerRadius="8" Padding="3" VerticalAlignment="Center"
                            AutomationProperties.Name="{l:Loc ignore.sizes.name}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource RadioButton.Toggle}" GroupName="PreviewSizes" Content="{l:Loc ignore.sizes.inBackup}"
                                         ToolTip="{l:Loc ignore.sizes.inBackupToolTip}"
                                         IsChecked="{Binding Preview.Tree.ShowInBackup}" />
                            <RadioButton Style="{StaticResource RadioButton.Toggle}" GroupName="PreviewSizes" Content="{l:Loc ignore.sizes.total}"
                                         Margin="2,0,0,0" ToolTip="{l:Loc ignore.sizes.totalToolTip}"
                                         IsChecked="{Binding Preview.Tree.ShowTotal}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <WrapPanel>
                    <WrapPanel.Style>
                        <Style TargetType="WrapPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Preview.InBackupText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </WrapPanel.Style>
                    <Border Style="{StaticResource Border.Pill}">
                        <DockPanel>
                            <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource Brush.Accent}" />
                            <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding Preview.InBackupText}"
                                       ToolTip="{Binding Preview.InBackupText}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Border.Pill}">
                        <DockPanel>
                            <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource Brush.TextFaint}" />
                            <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding Preview.IgnoredText}"
                                       ToolTip="{Binding Preview.IgnoredText}" />
                        </DockPanel>
                    </Border>
                </WrapPanel>
            </DockPanel>

            <!-- Tree -->
            <Border Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource Border.Card}" Padding="8,4,8,8">
                <ListView x:Name="RowsList" Style="{StaticResource ListView.Table}" SelectionMode="Single"
                          AutomationProperties.Name="{l:Loc ignore.tree.name}"
                          ItemsSource="{Binding Preview.Tree.Rows}"
                          SelectedItem="{Binding Preview.Tree.SelectedRow}"
                          SelectionChanged="OnRowSelectionChanged"
                          SizeChanged="OnRowsListSizeChanged"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{l:Loc ignore.tree.ignoreThis}" Command="{Binding IgnoreSelectedCommand}" />
                            <MenuItem Header="{l:Loc ignore.tree.ignoreExtension}"
                                      Command="{Binding IgnoreSelectedExtensionCommand}" />
                            <MenuItem Header="{l:Loc ignore.tree.unignore}" Command="{Binding UnignoreSelectedCommand}" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="ToolTip" Value="{Binding StatusDetail}" />
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnRowRightButtonDown" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPartial}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.PartialRow}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsIgnored}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.IgnoredRow}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
                                    <Setter Property="FontStyle" Value="Italic" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn x:Name="NameColumn" Header="{l:Loc common.name}" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                                            <ToggleButton Style="{StaticResource ToggleButton.Expander}"
                                                          AutomationProperties.Name="{l:Loc common.expand}" IsChecked="{Binding IsExpanded}" />
                                            <TextBlock Margin="0,0,6,0" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Icon}">
                                                        <Setter Property="Text" Value="{StaticResource Icon.Document}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                <Setter Property="Text" Value="{StaticResource Icon.Folder}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{l:Loc common.files}" Width="96" HeaderContainerStyle="{StaticResource Header.Number}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource TextBlock.Number}" Text="{Binding ShownFilesText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{l:Loc common.size}" Width="96" HeaderContainerStyle="{StaticResource Header.Number}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource TextBlock.Number}" Text="{Binding ShownSizeText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{l:Loc ignore.tree.percent}" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Height="16" Margin="0,0,6,0" CornerRadius="4" Background="{DynamicResource Brush.Bg}"
                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <ProgressBar Height="14" Maximum="100" Background="Transparent"
                                                             Foreground="{DynamicResource Brush.PercentFill}"
                                                             Value="{Binding ShownPercent, Mode=OneWay}" />
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"
                                                           Typography.NumeralAlignment="Tabular" Text="{Binding ShownPercentText}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{l:Loc common.status}" Width="124">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x23F3;" Margin="0,0,4,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPartial}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.WarningMark}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsIgnored}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsNotScanned}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.TextFaint}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <GridSplitter Grid.Row="4" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          AutomationProperties.Name="{l:Loc ignore.treemap.resize}" />

            <!-- Treemap -->
            <Border Grid.Row="5" Style="{StaticResource Border.Card}" Padding="8">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="4,8,4,0">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource TextBlock.Small}" Margin="12,0,0,0"
                                   Text="{l:Loc ignore.treemap.hover}" />
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Small}">
                                    <Setter Property="Text" Value="{l:Loc ignore.treemap.byBackup}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Preview.Tree.ShowInBackup}" Value="False">
                                            <Setter Property="Text" Value="{l:Loc ignore.treemap.byTotal}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                    <Grid>
                        <controls:TreemapControl Root="{Binding Preview.Root}"
                                                 Selected="{Binding Preview.SelectedNode}"
                                                 HideIgnored="{Binding Preview.Tree.ShowInBackup}" />
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"
                                   Text="{l:Loc ignore.treemap.empty}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Preview.IsIndexing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
