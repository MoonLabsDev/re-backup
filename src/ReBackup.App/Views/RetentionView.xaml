<UserControl x:Class="ReBackup.App.Views.RetentionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ReBackup.App.ViewModels"
             xmlns:controls="clr-namespace:ReBackup.App.Controls"
             xmlns:theme="clr-namespace:ReBackup.App.Theme">
    <UserControl.Resources>
        <Style x:Key="TextBlock.Error" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- An error line that disappears while its text is null. -->
        <Style x:Key="TextBlock.ErrorOrNone" TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Error}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TextBlock.Label" TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Muted}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <theme:EnumMatchConverter x:Key="Converter.EnumMatch" />

        <!-- Words of a rule sentence between its fields. -->
        <Style x:Key="TextBlock.Sentence" TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Muted}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,6" />
        </Style>

        <!-- Big number of the forecast. -->
        <Style x:Key="TextBlock.Kpi" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        </Style>

        <!-- An inline field of a rule sentence (keep count, day of month, date). -->
        <Style x:Key="TextBox.Cell" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="48" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <!-- The weekday list inside a rule sentence. -->
        <Style x:Key="ComboBox.Cell" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
        </Style>

        <!-- The period of a rule: a coloured pill (DAILY teal, WEEKLY blue, MONTHLY violet, YEARLY amber) that is
             still a ComboBox. The text is the rule's PeriodLabel; the drop-down lists the periods as usual. -->
        <Style x:Key="ComboBox.Badge" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="24" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Accent}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Badge.DailyFill}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Badge.DailyText}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
                            <Border x:Name="Pill" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="10,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PeriodLabel}" VerticalAlignment="Center" />
                                    <TextBlock Margin="6,1,0,0" VerticalAlignment="Center" FontFamily="{StaticResource Font.Icon}"
                                               FontSize="8" FontWeight="Normal" Text="{StaticResource Icon.ChevronDown}" />
                                </StackPanel>
                            </Border>
                            <!-- Takes the clicks; transparent. -->
                            <ToggleButton Focusable="False" IsTabStop="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" VerticalOffset="2" Focusable="False"
                                   PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border MinWidth="120" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.BorderStrong}"
                                        BorderThickness="1" CornerRadius="8" Padding="4" SnapsToDevicePixels="True"
                                        TextElement.FontWeight="Normal" TextElement.FontSize="13">
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush"
                                        Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush"
                                        Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Period}" Value="Weekly">
                    <Setter Property="Background" Value="{DynamicResource Brush.Badge.WeeklyFill}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Badge.WeeklyText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Period}" Value="Monthly">
                    <Setter Property="Background" Value="{DynamicResource Brush.Badge.MonthlyFill}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Badge.MonthlyText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Period}" Value="Yearly">
                    <Setter Property="Background" Value="{DynamicResource Brush.Badge.YearlyFill}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Badge.YearlyText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20">

            <!-- ======================================================== Rules + forecast -->
            <Border Style="{StaticResource Border.Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" VerticalAlignment="Center" Command="{Binding AddRetentionRuleCommand}"
                                AutomationProperties.Name="Add rule">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource TextBlock.Icon}" FontSize="12" Text="{StaticResource Icon.Add}" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Add rule" />
                            </StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource TextBlock.CardTitle}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="RULES — A VERSION STAYS IF ANY RULE KEEPS IT"
                                   ToolTip="The newest version always stays as well." />
                    </DockPanel>

                    <TextBlock Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="No rules: every version is kept and the target fills up over time.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoRetentionRules}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Rule tiles, three per row (two or one when narrow). The negative right margin takes back the gap after the last column. -->
                    <ItemsControl ItemsSource="{Binding RetentionRuleRows}" Focusable="False" Margin="0,0,-12,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:TileGrid Columns="3" MinColumnWidth="260" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,12,12" Padding="14" Background="{DynamicResource Brush.Bg}"
                                        BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="10">
                                    <StackPanel>
                                        <!-- Period badge (a pill-shaped ComboBox) and remove -->
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Danger}" Width="28" Height="28"
                                                    Content="{StaticResource Icon.Delete}" VerticalAlignment="Center"
                                                    ToolTip="Remove this rule" AutomationProperties.Name="Remove this rule"
                                                    Command="{Binding DataContext.RemoveRetentionRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <ComboBox Style="{StaticResource ComboBox.Badge}" HorizontalAlignment="Left"
                                                      AutomationProperties.Name="Period" ToolTip="Change the period"
                                                      ItemsSource="{x:Static vm:RetentionRuleViewModel.Periods}"
                                                      SelectedItem="{Binding Period}" />
                                        </DockPanel>

                                        <!-- The rule as a sentence:
                                             Daily "keep the last [7] days", Weekly "on [Sunday] keep [4]",
                                             Monthly "on day [1] keep [12]", Yearly "on [01-01] keep [3]". -->
                                        <WrapPanel Margin="0,12,0,0">
                                            <TextBlock Style="{StaticResource TextBlock.Sentence}" Text="keep the last"
                                                       Visibility="{Binding Period, Converter={StaticResource Converter.EnumMatch}, ConverterParameter=Daily}" />
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Sentence}">
                                                        <Setter Property="Text" Value="on" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Period}" Value="Daily">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Period}" Value="Monthly">
                                                                <Setter Property="Text" Value="on day" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ComboBox Style="{StaticResource ComboBox.Cell}" Width="116" AutomationProperties.Name="Weekday"
                                                      ToolTip="{Binding AnchorHint}"
                                                      ItemsSource="{x:Static vm:RetentionRuleViewModel.Weekdays}"
                                                      SelectedItem="{Binding Weekday}"
                                                      Visibility="{Binding Period, Converter={StaticResource Converter.EnumMatch}, ConverterParameter=Weekly}" />
                                            <TextBox AutomationProperties.Name="Anchor" ToolTip="{Binding AnchorHint}"
                                                     Text="{Binding AnchorText, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource TextBox.Cell}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Period}" Value="Monthly">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Period}" Value="Yearly">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="Width" Value="66" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <TextBlock Text="keep">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Sentence}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Period}" Value="Daily">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox AutomationProperties.Name="Keep"
                                                     Text="{Binding KeepText, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource TextBox.Cell}">
                                                        <Setter Property="ToolTip" Value="How many versions this rule keeps" />
                                                        <Style.Triggers>
                                                            <!-- A daily rule has no anchor field: its hint goes here. -->
                                                            <DataTrigger Binding="{Binding Period}" Value="Daily">
                                                                <Setter Property="ToolTip" Value="{Binding AnchorHint}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <TextBlock Style="{StaticResource TextBlock.Sentence}" Text="days"
                                                       Visibility="{Binding Period, Converter={StaticResource Converter.EnumMatch}, ConverterParameter=Daily}" />
                                        </WrapPanel>

                                        <TextBlock Style="{StaticResource TextBlock.ErrorOrNone}" Margin="0,4,0,0" FontSize="12"
                                                   Text="{Binding Error}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ======================================== Forecast -->
                    <Border Height="1" Margin="0,2,0,16" Background="{DynamicResource Brush.Border}" />

                    <WrapPanel Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource TextBlock.CardTitle}" VerticalAlignment="Center"
                                   Text="FORECAST — TWO YEARS OF" />
                        <ComboBox Margin="8,0,0,0" Width="170" Height="28" DisplayMemberPath="RunsLabel"
                                  AutomationProperties.Name="Assumed schedule"
                                  ToolTip="The plan has no triggers: the forecast assumes this schedule."
                                  ItemsSource="{x:Static vm:RetentionPreviewViewModel.Schedules}"
                                  SelectedItem="{Binding RetentionPreview.SelectedSchedule}">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RetentionPreview.UsesPlanSchedule}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="THE PLAN'S SCHEDULE">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock.CardTitle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RetentionPreview.UsesPlanSchedule}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </WrapPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- KPIs; the sentence with the details is their tool tip. -->
                        <StackPanel Margin="0,0,28,0" MinWidth="130" Background="Transparent"
                                    ToolTip="{Binding RetentionPreview.FullSummary}"
                                    Visibility="{Binding RetentionPreview.HasForecast, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource TextBlock.Label}" Text="Versions kept" />
                            <TextBlock Style="{StaticResource TextBlock.Kpi}" Text="{Binding RetentionPreview.ForecastVersionsText}"
                                       AutomationProperties.Name="Versions kept" />
                            <TextBlock Style="{StaticResource TextBlock.Label}" Margin="0,12,0,0" Text="Space" />
                            <TextBlock Style="{StaticResource TextBlock.Kpi}" Text="{Binding RetentionPreview.ForecastSpaceText}"
                                       AutomationProperties.Name="Space" />
                        </StackPanel>

                        <!-- Without numbers (calculating, invalid triggers, an error) the sentence says why. -->
                        <TextBlock Grid.ColumnSpan="2" TextWrapping="Wrap" Text="{Binding RetentionPreview.FullSummary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Muted}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RetentionPreview.HasForecast}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Hidden while recalculating (or without a forecast): the sentence above takes the room. -->
                        <ScrollViewer Grid.Column="1" MaxHeight="180" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding RetentionPreview.HasForecast, Converter={StaticResource BoolToVisibility}}">
                            <controls:RetentionTimelineControl Lanes="{Binding RetentionPreview.TimelineLanes}"
                                                               From="{Binding RetentionPreview.TimelineFrom}"
                                                               To="{Binding RetentionPreview.TimelineTo}" />
                        </ScrollViewer>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ======================================================== Versions now -->
            <Border Style="{StaticResource Border.Card}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="{StaticResource Icon.Refresh}"
                                ToolTip="Read the target again" AutomationProperties.Name="Refresh"
                                Command="{Binding RetentionPreview.RefreshCommand}" />
                        <ProgressBar DockPanel.Dock="Right" Width="80" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                                     IsIndeterminate="{Binding RetentionPreview.IsLoading}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RetentionPreview.IsLoading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock Style="{StaticResource TextBlock.CardTitle}" VerticalAlignment="Center"
                                   Text="VERSIONS IN THE TARGET NOW" />
                    </DockPanel>

                    <TextBlock Margin="0,0,0,8" Text="{Binding RetentionPreview.Error}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Error}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RetentionPreview.Error}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Hidden while the empty state over the table says the same. -->
                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="{Binding RetentionPreview.NowSummary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RetentionPreview.ShowEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid>
                        <ListView Style="{StaticResource ListView.Table}" ItemsSource="{Binding RetentionPreview.NowRows}"
                                  MinHeight="80" MaxHeight="360" SelectionMode="Single">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDelete}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsManaged}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Date" Width="120" DisplayMemberBinding="{Binding DateText}" />
                                    <GridViewColumn Header="Decision" Width="90" DisplayMemberBinding="{Binding DecisionText}" />
                                    <GridViewColumn Header="Kept by" Width="210" DisplayMemberBinding="{Binding ReasonText}" />
                                    <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding SizeText}" />
                                    <GridViewColumn Header="Files" Width="70" DisplayMemberBinding="{Binding FilesText}" />
                                    <GridViewColumn Header="Folder" Width="260">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Left" Style="{StaticResource Button.Icon}" Width="26" Height="26"
                                                            Margin="0,0,6,0"
                                                            ToolTip="Open in Explorer" AutomationProperties.Name="Open the version folder"
                                                            Command="{Binding DataContext.RetentionPreview.OpenVersionFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
<Image Style="{StaticResource Image.FolderColored}" />
</Button>
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" ToolTip="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- Empty state -->
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                                   IsHitTestVisible="False" Text="{Binding RetentionPreview.EmptyText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Muted}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RetentionPreview.ShowEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
