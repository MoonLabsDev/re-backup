<Window x:Class="ReBackup.App.Views.VerifyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ReBackup.Shared.Wpf.Localization;assembly=ReBackup.Shared.Wpf"
        Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}">
    <!-- "Verify backup…": Quick | Thorough, progress, and the versions and files whose content is missing or damaged. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LocationEditors.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="TextBlock.Optional" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,10,0,0" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                    <Trigger Property="Text" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="20,18">
        <TextBlock Style="{StaticResource TextBlock.CardTitle}" Margin="0,0,0,6" TextWrapping="Wrap" Text="{Binding Heading}" />
        <TextBlock Style="{StaticResource TextBlock.Muted}" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap" Text="{l:Loc verify.hint}" />

        <DockPanel IsEnabled="{Binding CanChoose}">
            <Border Style="{StaticResource Border.KindSwitch}" AutomationProperties.Name="{l:Loc verify.mode}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource RadioButton.Kind}" Content="{l:Loc verify.quick}" ToolTip="{l:Loc verify.quickToolTip}"
                                 IsChecked="{Binding IsQuick, Mode=OneWay}" Command="{Binding ChooseModeCommand}" CommandParameter="Quick" />
                    <RadioButton Style="{StaticResource RadioButton.Kind}" Content="{l:Loc verify.thorough}" ToolTip="{l:Loc verify.thoroughToolTip}"
                                 IsChecked="{Binding Thorough, Mode=OneWay}" Command="{Binding ChooseModeCommand}" CommandParameter="Thorough" />
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource TextBlock.Muted}" FontSize="12" Margin="0,0,0,6" VerticalAlignment="Bottom"
                       Text="{l:Loc verify.mode}" />
        </DockPanel>

        <!-- Why the verify did not run or stopped -->
        <TextBlock Style="{StaticResource TextBlock.Optional}" Foreground="{DynamicResource Brush.Warning}" Text="{Binding Message}" />

        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsRunning, Converter={StaticResource Converter.Visible}}">
            <TextBlock Style="{StaticResource TextBlock.Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding ProgressText}" />
            <ProgressBar Margin="0,4,0,0" Height="6" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}" />
        </StackPanel>

        <TextBlock Style="{StaticResource TextBlock.Optional}" Text="{Binding Summary}" />
        <ListView Margin="0,8,0,0" MaxHeight="260" ItemsSource="{Binding Problems}" AutomationProperties.Name="{l:Loc verify.problemsName}">
            <ListView.Style>
                <Style TargetType="ListView" BasedOn="{StaticResource {x:Type ListView}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Problems.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.Style>
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="190" Header="{l:Loc common.version}" DisplayMemberBinding="{Binding Version}" />
                    <GridViewColumn Width="250" Header="{l:Loc common.path}" DisplayMemberBinding="{Binding Path}" />
                    <GridViewColumn Width="150" Header="{l:Loc verify.problem}" DisplayMemberBinding="{Binding Problem}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button MinWidth="96" Style="{StaticResource Button.Accent}" IsDefault="True" Content="{l:Loc verify.start}"
                    AutomationProperties.Name="{l:Loc verify.start}" Command="{Binding StartCommand}" />
            <Button MinWidth="80" Margin="8,0,0,0" Content="{l:Loc common.cancel}" AutomationProperties.Name="{l:Loc common.cancel}"
                    Command="{Binding CancelCommand}" Visibility="{Binding IsRunning, Converter={StaticResource Converter.Visible}}" />
            <Button MinWidth="80" Margin="8,0,0,0" IsCancel="True" Content="{l:Loc common.close}"
                    AutomationProperties.Name="{l:Loc common.close}" />
        </StackPanel>
    </StackPanel>
</Window>
