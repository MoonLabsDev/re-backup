<UserControl x:Class="ReBackup.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ReBackup.App.ViewModels"
             xmlns:core="clr-namespace:ReBackup.Core.Backup;assembly=ReBackup.Core"
             xmlns:l="clr-namespace:ReBackup.Shared.Wpf.Localization;assembly=ReBackup.Shared.Wpf">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Read-only, copyable lines of a run's details; takes no room while empty. -->
        <Style x:Key="TextBox.Details" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MaxHeight" Value="160" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24,20">
        <Border Style="{StaticResource Border.Card}" Padding="0,18,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,0,18,12">
                    <TextBlock Style="{StaticResource TextBlock.CardTitle}" Text="{l:Loc history.title}" />
                    <TextBlock Style="{StaticResource TextBlock.Muted}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding Run.LastRunText}" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Run.History}" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0,1,0,0"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                          CanUserResizeRows="False" RowDetailsVisibilityMode="VisibleWhenSelected">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:Loc history.column.start}" Width="140" Binding="{Binding StartText}" />
                        <DataGridTextColumn Header="{l:Loc history.column.duration}" Width="110" Binding="{Binding DurationText}" />
                        <DataGridTextColumn Header="{l:Loc history.column.trigger}" Width="100" Binding="{Binding TriggerText}" />
                        <DataGridTemplateColumn Header="{l:Loc history.column.result}" Width="250" SortMemberPath="StatusText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Outcome}" Value="{x:Static vm:RunOutcome.Warning}">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.WarningMark}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Outcome}" Value="{x:Static vm:RunOutcome.Failed}">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding StatusText}" ToolTip="{Binding StatusText}" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{l:Loc common.files}" Width="70" Binding="{Binding FilesText}" />
                        <DataGridTextColumn Header="{l:Loc common.size}" Width="80" Binding="{Binding SizeText}" />
                        <DataGridTextColumn Header="{l:Loc history.column.reason}" Width="*" Binding="{Binding Reason}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Reason}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- Opens the version the run produced; disabled when that folder no longer exists (checked
                             when the history loads). -->
                        <DataGridTemplateColumn Width="48" CanUserResize="False" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Button.Icon}" Width="28" Height="26"
                                            HorizontalAlignment="Center"
                                            AutomationProperties.Name="{l:Loc history.openVersion.name}"
                                            ToolTip="{Binding OpenVersionToolTip}" ToolTipService.ShowOnDisabled="True"
                                            Visibility="{Binding HasVersion, Converter={StaticResource BoolToVisibility}}"
                                            IsEnabled="{Binding CanOpenVersion}"
                                            Command="{Binding DataContext.OpenRunVersionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
<Image Style="{StaticResource Image.FolderColored}" />
</Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <StackPanel Margin="12,4,12,8" Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
                                <TextBox Style="{StaticResource TextBox.Details}" Text="{Binding VersionText, Mode=OneWay}" />

                                <!-- The skipped entries as a tree: red gone from the source, yellow changed while copied. -->
                                <StackPanel Visibility="{Binding HasSkipped, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Margin="2,6,0,4" FontSize="12" FontWeight="SemiBold" Text="{Binding SkippedTitle}" />
                                    <ListView Style="{StaticResource ListView.Table}" MaxHeight="320" SelectionMode="Single"
                                              AutomationProperties.Name="{l:Loc history.skippedTree.name}"
                                              ItemsSource="{Binding SkippedTree.Rows}"
                                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                              ScrollViewer.CanContentScroll="True">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="ToolTip" Value="{Binding Path}" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="{l:Loc common.name}" Width="520">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                                                                <ToggleButton Style="{StaticResource ToggleButton.Expander}"
                                                                              AutomationProperties.Name="{l:Loc common.expand}" IsChecked="{Binding IsExpanded}" />
                                                                <TextBlock Margin="0,0,6,0" FontSize="12">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Icon}">
                                                                            <Setter Property="Text" Value="{StaticResource Icon.Document}" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                                    <Setter Property="Text" Value="{StaticResource Icon.Folder}" />
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="{l:Loc history.column.reason}" Width="420">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                    <Ellipse.Style>
                                                                        <Style TargetType="Ellipse">
                                                                            <Setter Property="Fill" Value="{DynamicResource Brush.TextFaint}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:SkipKind.Deleted}">
                                                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:SkipKind.Changed}">
                                                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Ellipse.Style>
                                                                </Ellipse>
                                                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                           Text="{Binding ReasonText}" ToolTip="{Binding ReasonText}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:SkipKind.Deleted}">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:SkipKind.Changed}">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsSummary}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                    <TextBlock Margin="2,4,0,0" FontSize="12" Text="{Binding SkippedMoreText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Muted}">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <TextBox Style="{StaticResource TextBox.Details}" Margin="0,6,0,0" Text="{Binding FooterText, Mode=OneWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
