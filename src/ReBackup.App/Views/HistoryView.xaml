<UserControl x:Class="ReBackup.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ReBackup.App.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Grid Margin="24,20">
        <Border Style="{StaticResource Border.Card}" Padding="0,18,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,0,18,12">
                    <TextBlock Style="{StaticResource TextBlock.CardTitle}" Text="RUN HISTORY" />
                    <TextBlock Style="{StaticResource TextBlock.Muted}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding Run.LastRunText}" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Run.History}" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0,1,0,0"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                          CanUserResizeRows="False" RowDetailsVisibilityMode="VisibleWhenSelected">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Start" Width="140" Binding="{Binding StartText}" />
                        <DataGridTextColumn Header="Duration" Width="110" Binding="{Binding DurationText}" />
                        <DataGridTextColumn Header="Trigger" Width="80" Binding="{Binding TriggerText}" />
                        <DataGridTemplateColumn Header="Result" Width="190" SortMemberPath="StatusText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Outcome}" Value="{x:Static vm:RunOutcome.Warning}">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Outcome}" Value="{x:Static vm:RunOutcome.Failed}">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding StatusText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Files" Width="70" Binding="{Binding FilesText}" />
                        <DataGridTextColumn Header="Size" Width="80" Binding="{Binding SizeText}" />
                        <DataGridTextColumn Header="Reason" Width="*" Binding="{Binding Reason}" />
                        <!-- Opens the version the run produced; disabled when that folder no longer exists (checked
                             when the history loads). -->
                        <DataGridTemplateColumn Width="48" CanUserResize="False" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Button.Icon}" Width="28" Height="26"
                                            HorizontalAlignment="Center"
                                            AutomationProperties.Name="Open the version folder"
                                            ToolTip="{Binding OpenVersionToolTip}" ToolTipService.ShowOnDisabled="True"
                                            Visibility="{Binding HasVersion, Converter={StaticResource BoolToVisibility}}"
                                            IsEnabled="{Binding CanOpenVersion}"
                                            Command="{Binding DataContext.OpenRunVersionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
<Image Style="{StaticResource Image.FolderColored}" />
</Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <TextBox Margin="12,4" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     FontFamily="{StaticResource Font.Mono}" FontSize="12" MaxHeight="200" VerticalScrollBarVisibility="Auto"
                                     Text="{Binding Details, Mode=OneWay}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDetails}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
