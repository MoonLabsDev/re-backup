<UserControl x:Class="ReBackup.App.Views.PlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ReBackup.App.ViewModels">
    <UserControl.Resources>
        <!-- Field label above an input. -->
        <Style x:Key="TextBlock.Label" TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Muted}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- Path input with room for the folder button inside its right end. -->
        <Style x:Key="TextBox.Path" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,3,38,3" />
            <Setter Property="MinHeight" Value="34" />
        </Style>

        <Style x:Key="Button.Browse" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A short field inside a trigger row (time, day, hours). -->
        <Style x:Key="TextBox.Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="TextBlock.RowText" TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Muted}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
        </Style>

        <!-- A value tile of the Last run card. -->
        <Style x:Key="Border.Tile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Bg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <Style x:Key="TextBlock.TileValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="250" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ======================================================== Source → Target -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Border.Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextBlock.CardTitle}" Margin="0,0,0,14" Text="SOURCE → TARGET" />

                    <TextBlock Style="{StaticResource TextBlock.Label}" Text="Name" />
                    <TextBox MinHeight="34" AutomationProperties.Name="Name"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource TextBlock.Label}" Margin="0,12,0,6" Text="Source" />
                    <Grid>
                        <TextBox Style="{StaticResource TextBox.Path}" AutomationProperties.Name="Source"
                                 Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{StaticResource Button.Browse}"
                                ToolTip="Choose the source folder" AutomationProperties.Name="Choose the source folder"
                                Command="{Binding DataContext.BrowseSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}">
<Image Style="{StaticResource Image.FolderColored}" />
</Button>
                    </Grid>

                    <TextBlock Style="{StaticResource TextBlock.Label}" Margin="0,12,0,6" Text="Target" />
                    <Grid>
                        <TextBox Style="{StaticResource TextBox.Path}" AutomationProperties.Name="Target"
                                 Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{StaticResource Button.Browse}"
                                ToolTip="Choose the target folder" AutomationProperties.Name="Choose the target folder"
                                Command="{Binding DataContext.BrowseTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}">
<Image Style="{StaticResource Image.FolderColored}" />
</Button>
                    </Grid>

                    <CheckBox Style="{StaticResource CheckBox.Switch}" Margin="0,16,0,0" IsChecked="{Binding Enabled}"
                              ToolTip="When off, the plan runs only when started by hand.">
                        <TextBlock TextWrapping="Wrap" Text="Run on schedule" />
                    </CheckBox>
                    <CheckBox Style="{StaticResource CheckBox.Switch}" Margin="0,10,0,0" IsChecked="{Binding FreeSpaceByRetention}">
                        <TextBlock TextWrapping="Wrap"
                                   Text="When the target is full, first delete versions that retention would delete anyway" />
                    </CheckBox>

                    <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Errors}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Danger}"
                                           Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ======================================================== Last run -->
            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Border.Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextBlock.CardTitle}" Margin="0,0,0,14" Text="LAST RUN" />

                    <TextBlock Text="Never run">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Muted}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Run.HasRun}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel DataContext="{Binding Run.LastRun}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,6,0,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Outcome}" Value="{x:Static vm:RunOutcome.Warning}">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.WarningMark}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Outcome}" Value="{x:Static vm:RunOutcome.Failed}">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Grid.Column="1" Margin="8,0,0,0" TextWrapping="Wrap">
                                <Run Text="{Binding StatusText, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{Binding TriggerText, Mode=OneWay, StringFormat='· {0}'}"
                                     Foreground="{DynamicResource Brush.TextMuted}" />
                                <Run Text="{Binding StartText, Mode=OneWay, StringFormat='· {0}'}"
                                     Foreground="{DynamicResource Brush.TextMuted}" />
                            </TextBlock>
                        </Grid>

                        <TextBlock Margin="16,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}"
                                   Text="{Binding Reason}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Reason}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <UniformGrid Margin="-5,9,-5,-5" Columns="2">
                            <Border Style="{StaticResource Border.Tile}" Margin="5">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TextBlock.Muted}" FontSize="12" Text="Duration" />
                                    <TextBlock Style="{StaticResource TextBlock.TileValue}" Text="{Binding DurationText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Border.Tile}" Margin="5">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TextBlock.Muted}" FontSize="12" Text="Copied" />
                                    <TextBlock Style="{StaticResource TextBlock.TileValue}" Text="{Binding SizeText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Border.Tile}" Margin="5">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TextBlock.Muted}" FontSize="12" Text="Files" />
                                    <TextBlock Style="{StaticResource TextBlock.TileValue}" Text="{Binding FilesText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Border.Tile}" Margin="5">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TextBlock.Muted}" FontSize="12" Text="Skipped" />
                                    <TextBlock Style="{StaticResource TextBlock.TileValue}" Text="{Binding SkippedText}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ======================================================== Schedule -->
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource Border.Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Command="{Binding AddTriggerCommand}" AutomationProperties.Name="Add trigger">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource TextBlock.Icon}" FontSize="12" Text="{StaticResource Icon.Add}" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Add trigger" />
                            </StackPanel>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextBlock.CardTitle}" Text="SCHEDULE" />
                            <TextBlock Style="{StaticResource TextBlock.Muted}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                       Text="The plan runs at each of these local times." />
                        </StackPanel>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding TriggerRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="10,6" Background="{DynamicResource Brush.Bg}"
                                        BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Danger}"
                                                    Content="{StaticResource Icon.Delete}"
                                                    ToolTip="Remove this trigger" AutomationProperties.Name="Remove this trigger"
                                                    Command="{Binding DataContext.RemoveTriggerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />

                                            <WrapPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource TextBlock.Icon}" Margin="0,0,10,0"
                                                           Foreground="{DynamicResource Brush.TextMuted}" Text="{StaticResource Icon.Clock}" />
                                                <ComboBox Width="112" AutomationProperties.Name="Trigger type"
                                                          ItemsSource="{x:Static vm:TriggerRowViewModel.Types}"
                                                          SelectedItem="{Binding Type}" />

                                                <!-- Daily, Weekly, Monthly: time -->
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="Interval">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Style="{StaticResource TextBlock.RowText}" Text="at" />
                                                    <TextBox Style="{StaticResource TextBox.Field}" Width="64" AutomationProperties.Name="Time"
                                                             Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>

                                                <!-- Monthly: day -->
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="Monthly">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Style="{StaticResource TextBlock.RowText}" Text="on day" />
                                                    <TextBox Style="{StaticResource TextBox.Field}" Width="48" AutomationProperties.Name="Day of month"
                                                             Text="{Binding DayText, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Style="{StaticResource TextBlock.RowText}" FontSize="12"
                                                               Foreground="{DynamicResource Brush.TextFaint}"
                                                               Text="0 = last day, -1 = the day before" />
                                                </StackPanel>

                                                <!-- Interval: every … hours from … to … -->
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="Interval">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Style="{StaticResource TextBlock.RowText}" Text="every" />
                                                    <TextBox Style="{StaticResource TextBox.Field}" Width="44" AutomationProperties.Name="Every hours"
                                                             Text="{Binding EveryHoursText, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Style="{StaticResource TextBlock.RowText}" Text="hours from" />
                                                    <TextBox Style="{StaticResource TextBox.Field}" Width="64" AutomationProperties.Name="From"
                                                             Text="{Binding FromText, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Style="{StaticResource TextBlock.RowText}" Text="to" />
                                                    <TextBox Style="{StaticResource TextBox.Field}" Width="64" AutomationProperties.Name="To"
                                                             Text="{Binding ToText, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Style="{StaticResource TextBlock.RowText}" FontSize="12"
                                                               Foreground="{DynamicResource Brush.TextFaint}" Text="empty = whole day" />
                                                </StackPanel>
                                            </WrapPanel>
                                        </DockPanel>

                                        <!-- Weekly: weekdays -->
                                        <ItemsControl Margin="24,8,0,2" ItemsSource="{Binding Weekdays}" Focusable="False">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Weekly">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Margin="0,0,14,0" Content="{Binding Name}" IsChecked="{Binding IsChecked}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Margin="24,6,0,2" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Danger}"
                                                   Text="{Binding Error}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Next runs as chips -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NextRuns.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource TextBlock.Muted}" Margin="0,8,0,8" FontSize="12" Text="Next runs" />
                        <ItemsControl ItemsSource="{Binding NextRuns}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,8,8" Padding="10,4" CornerRadius="6" Background="{DynamicResource Brush.AccentSoft}">
                                        <TextBlock Style="{StaticResource TextBlock.Mono}" Foreground="{DynamicResource Brush.AccentLight}"
                                                   Text="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Tray hint, disabled plan, unsaved edits; Warning while the scheduler is paused. -->
                    <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding NextRunsNote}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Muted}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SchedulerPaused}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
