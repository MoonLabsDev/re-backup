<UserControl x:Class="ReBackup.App.Views.PlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ReBackup.App.ViewModels"
             xmlns:l="clr-namespace:ReBackup.Shared.Wpf.Localization;assembly=ReBackup.Shared.Wpf">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LocationEditors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Field label above an input. -->
            <Style x:Key="TextBlock.Label" TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Muted}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <!-- A short field inside a trigger row (time, day, hours). -->
            <Style x:Key="TextBox.Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="TextBlock.RowText" TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Muted}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="8,0" />
            </Style>

            <!-- A value tile of the Last run card. -->
            <Style x:Key="Border.Tile" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Brush.Bg}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="10" />
            </Style>

            <Style x:Key="TextBlock.TileValue" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,4,0,0" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <DockPanel Margin="24,20">
        <!-- An incremental plan's target is locked: who holds it since when, and "Release lock…" for a stale lock. -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,16" Padding="14,10" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource Brush.Warning}" Background="{DynamicResource Brush.Surface}"
                Visibility="{Binding HasLock, Converter={StaticResource Converter.Visible}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="12,0,0,0" Content="{l:Loc plan.lock.release}"
                        AutomationProperties.Name="{l:Loc plan.lock.release}" Command="{Binding ReleaseLockCommand}" />
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource TextBlock.Icon}" Margin="0,0,10,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Warning}" Text="{StaticResource Icon.Warning}" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding LockBanner}" />
            </DockPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="250" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ======================================================== Source → Target -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Border.Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextBlock.CardTitle}" Margin="0,0,0,14" Text="{l:Loc plan.source.title}" />

                    <TextBlock Style="{StaticResource TextBlock.Label}" Text="{l:Loc common.name}" />
                    <TextBox MinHeight="34" AutomationProperties.Name="{l:Loc common.name}"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                    <DockPanel Margin="0,12,0,0">
                        <Border Style="{StaticResource Border.KindSwitch}" AutomationProperties.Name="{l:Loc plan.kind.sourceName}">
                            <StackPanel Orientation="Horizontal">
                                <!-- One-way plus a command: the view's DataContext switches between plans. -->
                                <RadioButton Style="{StaticResource RadioButton.Kind}" Content="{l:Loc plan.kind.folder}"
                                             IsChecked="{Binding SourceIsFolder, Mode=OneWay}"
                                             Command="{Binding ChooseSourceKindCommand}" CommandParameter="Folder" />
                                <RadioButton Style="{StaticResource RadioButton.Kind}" Content="{l:Loc plan.kind.s3}"
                                             IsChecked="{Binding SourceIsS3, Mode=OneWay}"
                                             Command="{Binding ChooseSourceKindCommand}" CommandParameter="S3" />
                                <RadioButton Style="{StaticResource RadioButton.Kind}" Content="{l:Loc plan.kind.drive}"
                                             IsChecked="{Binding SourceIsDrive, Mode=OneWay}"
                                             Command="{Binding ChooseSourceKindCommand}" CommandParameter="Drive" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource TextBlock.Label}" VerticalAlignment="Bottom" Text="{l:Loc plan.source.source}" />
                    </DockPanel>
                    <ContentControl Focusable="False" IsTabStop="False" Content="{Binding SourceS3}"
                                    ContentTemplate="{StaticResource S3LocationEditor}"
                                    Visibility="{Binding SourceIsS3, Converter={StaticResource Converter.Visible}}" />
                    <ContentControl Focusable="False" IsTabStop="False" Content="{Binding SourceDrive}"
                                    ContentTemplate="{StaticResource DriveLocationEditor}"
                                    Visibility="{Binding SourceIsDrive, Converter={StaticResource Converter.Visible}}" />
                    <Grid Visibility="{Binding SourceIsFolder, Converter={StaticResource Converter.Visible}}">
                        <TextBox Style="{StaticResource TextBox.Path}" AutomationProperties.Name="{l:Loc plan.source.source}"
                                 Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{StaticResource Button.Browse}"
                                ToolTip="{l:Loc plan.source.chooseSource}" AutomationProperties.Name="{l:Loc plan.source.chooseSource}"
                                Command="{Binding DataContext.BrowseSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}">
<Image Style="{StaticResource Image.FolderColored}" />
</Button>
                    </Grid>

                    <DockPanel Margin="0,12,0,0">
                        <Border Style="{StaticResource Border.KindSwitch}" AutomationProperties.Name="{l:Loc plan.kind.targetName}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource RadioButton.Kind}" Content="{l:Loc plan.kind.folder}"
                                             IsChecked="{Binding TargetIsFolder, Mode=OneWay}"
                                             Command="{Binding ChooseTargetKindCommand}" CommandParameter="Folder" />
                                <RadioButton Style="{StaticResource RadioButton.Kind}" Content="{l:Loc plan.kind.s3}"
                                             IsChecked="{Binding TargetIsS3, Mode=OneWay}"
                                             Command="{Binding ChooseTargetKindCommand}" CommandParameter="S3" />
                                <RadioButton Style="{StaticResource RadioButton.Kind}" Content="{l:Loc plan.kind.drive}"
                                             IsChecked="{Binding TargetIsDrive, Mode=OneWay}"
                                             Command="{Binding ChooseTargetKindCommand}" CommandParameter="Drive" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource TextBlock.Label}" VerticalAlignment="Bottom" Text="{l:Loc plan.source.target}" />
                    </DockPanel>
                    <ContentControl Focusable="False" IsTabStop="False" Content="{Binding TargetS3}"
                                    ContentTemplate="{StaticResource S3LocationEditor}"
                                    Visibility="{Binding TargetIsS3, Converter={StaticResource Converter.Visible}}" />
                    <ContentControl Focusable="False" IsTabStop="False" Content="{Binding TargetDrive}"
                                    ContentTemplate="{StaticResource DriveLocationEditor}"
                                    Visibility="{Binding TargetIsDrive, Converter={StaticResource Converter.Visible}}" />
                    <Grid Visibility="{Binding TargetIsFolder, Converter={StaticResource Converter.Visible}}">
                        <TextBox Style="{StaticResource TextBox.Path}" AutomationProperties.Name="{l:Loc plan.source.target}"
                                 Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{StaticResource Button.Browse}"
                                ToolTip="{l:Loc plan.source.chooseTarget}" AutomationProperties.Name="{l:Loc plan.source.chooseTarget}"
                                Command="{Binding DataContext.BrowseTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}">
<Image Style="{StaticResource Image.FolderColored}" />
</Button>
                    </Grid>

                    <!-- Storage format: chosen when the plan is created, then fixed. -->
                    <DockPanel Margin="0,16,0,0">
                        <Border Style="{StaticResource Border.KindSwitch}" AutomationProperties.Name="{l:Loc plan.format.title}"
                                IsEnabled="{Binding CanEditIncremental}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource RadioButton.Kind}" Content="{l:Loc plan.format.full}"
                                             IsChecked="{Binding IncrementalIsFull, Mode=OneWay}"
                                             Command="{Binding ChooseStorageFormatCommand}" CommandParameter="Full" />
                                <RadioButton Style="{StaticResource RadioButton.Kind}" Content="{l:Loc plan.format.incremental}"
                                             IsChecked="{Binding Incremental, Mode=OneWay}"
                                             Command="{Binding ChooseStorageFormatCommand}" CommandParameter="Incremental" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource TextBlock.Label}" VerticalAlignment="Bottom" Text="{l:Loc plan.format.title}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource TextBlock.Muted}" FontSize="12" TextWrapping="Wrap" Text="{l:Loc plan.format.hint}" />

                    <DockPanel Margin="0,12,0,0" Visibility="{Binding ShowChangeDetection, Converter={StaticResource Converter.Visible}}">
                        <Border Style="{StaticResource Border.KindSwitch}" AutomationProperties.Name="{l:Loc plan.compare.title}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource RadioButton.Kind}" Content="{l:Loc plan.compare.fast}"
                                             ToolTip="{l:Loc plan.compare.fastToolTip}"
                                             IsChecked="{Binding ChangeDetectionIsFast, Mode=OneWay}"
                                             Command="{Binding ChooseChangeDetectionCommand}" CommandParameter="Fast" />
                                <RadioButton Style="{StaticResource RadioButton.Kind}" Content="{l:Loc plan.compare.safe}"
                                             ToolTip="{l:Loc plan.compare.safeToolTip}"
                                             IsChecked="{Binding ChangeDetectionIsSafe, Mode=OneWay}"
                                             Command="{Binding ChooseChangeDetectionCommand}" CommandParameter="Safe" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource TextBlock.Label}" VerticalAlignment="Bottom" Text="{l:Loc plan.compare.title}" />
                    </DockPanel>

                    <CheckBox Style="{StaticResource CheckBox.Switch}" Margin="0,16,0,0" IsChecked="{Binding Enabled}"
                              ToolTip="{l:Loc plan.source.enabledToolTip}">
                        <TextBlock TextWrapping="Wrap" Text="{l:Loc plan.source.enabled}" />
                    </CheckBox>
                    <!-- Hidden for an S3 or Drive target: there is no free-space information. -->
                    <CheckBox Style="{StaticResource CheckBox.Switch}" Margin="0,10,0,0" IsChecked="{Binding FreeSpaceByRetention}"
                              Visibility="{Binding ShowFreeSpaceOption, Converter={StaticResource Converter.Visible}}">
                        <TextBlock TextWrapping="Wrap"
                                   Text="{l:Loc plan.source.freeSpace}" />
                    </CheckBox>

                    <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Errors}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Danger}"
                                           Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ======================================================== Last run -->
            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Border.Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextBlock.CardTitle}" Margin="0,0,0,14" Text="{l:Loc plan.lastRun.title}" />

                    <TextBlock Text="{l:Loc card.neverRun}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Muted}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Run.HasRun}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel DataContext="{Binding Run.LastRun}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,6,0,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Outcome}" Value="{x:Static vm:RunOutcome.Warning}">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.WarningMark}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Outcome}" Value="{x:Static vm:RunOutcome.Failed}">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Grid.Column="1" Margin="8,0,0,0" TextWrapping="Wrap">
                                <Run Text="{Binding StatusText, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{Binding TriggerText, Mode=OneWay, StringFormat='· {0}'}"
                                     Foreground="{DynamicResource Brush.TextMuted}" />
                                <Run Text="{Binding StartText, Mode=OneWay, StringFormat='· {0}'}"
                                     Foreground="{DynamicResource Brush.TextMuted}" />
                            </TextBlock>
                        </Grid>

                        <TextBlock Margin="16,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}"
                                   Text="{Binding Reason}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Reason}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <UniformGrid Margin="-5,9,-5,-5" Columns="2">
                            <Border Style="{StaticResource Border.Tile}" Margin="5">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TextBlock.Muted}" FontSize="12" Text="{l:Loc plan.lastRun.duration}" />
                                    <TextBlock Style="{StaticResource TextBlock.TileValue}" Text="{Binding DurationText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Border.Tile}" Margin="5">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TextBlock.Muted}" FontSize="12" Text="{l:Loc plan.lastRun.copied}" />
                                    <TextBlock Style="{StaticResource TextBlock.TileValue}" Text="{Binding SizeText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Border.Tile}" Margin="5">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TextBlock.Muted}" FontSize="12" Text="{l:Loc common.files}" />
                                    <TextBlock Style="{StaticResource TextBlock.TileValue}" Text="{Binding FilesText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Border.Tile}" Margin="5">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TextBlock.Muted}" FontSize="12" Text="{l:Loc plan.lastRun.skipped}" />
                                    <TextBlock Style="{StaticResource TextBlock.TileValue}" Text="{Binding SkippedText}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ======================================================== Schedule -->
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource Border.Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Command="{Binding AddTriggerCommand}" AutomationProperties.Name="{l:Loc plan.schedule.add}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource TextBlock.Icon}" FontSize="12" Text="{StaticResource Icon.Add}" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{l:Loc plan.schedule.add}" />
                            </StackPanel>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextBlock.CardTitle}" Text="{l:Loc plan.schedule.title}" />
                            <TextBlock Style="{StaticResource TextBlock.Muted}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                       Text="{l:Loc plan.schedule.note}" />
                        </StackPanel>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding TriggerRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="10,6" Background="{DynamicResource Brush.Bg}"
                                        BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Danger}"
                                                    Content="{StaticResource Icon.Delete}"
                                                    ToolTip="{l:Loc plan.schedule.remove}" AutomationProperties.Name="{l:Loc plan.schedule.remove}"
                                                    Command="{Binding DataContext.RemoveTriggerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />

                                            <WrapPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource TextBlock.Icon}" Margin="0,0,10,0"
                                                           Foreground="{DynamicResource Brush.TextMuted}" Text="{StaticResource Icon.Clock}" />
                                                <ComboBox Width="124" AutomationProperties.Name="{l:Loc plan.schedule.type}"
                                                          ItemsSource="{x:Static vm:TriggerRowViewModel.Types}"
                                                          SelectedItem="{Binding Type}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{l:LocBind Prefix=enum.triggerType.}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>

                                                <!-- Daily, Weekly, Monthly: time -->
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="Interval">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Style="{StaticResource TextBlock.RowText}" Text="{l:Loc plan.schedule.at}" />
                                                    <TextBox Style="{StaticResource TextBox.Field}" Width="64" AutomationProperties.Name="{l:Loc plan.schedule.time}"
                                                             Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>

                                                <!-- Monthly: day -->
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="Monthly">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Style="{StaticResource TextBlock.RowText}" Text="{l:Loc plan.schedule.onDay}" />
                                                    <TextBox Style="{StaticResource TextBox.Field}" Width="48" AutomationProperties.Name="{l:Loc plan.schedule.dayOfMonth}"
                                                             Text="{Binding DayText, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Style="{StaticResource TextBlock.RowText}" FontSize="12"
                                                               Foreground="{DynamicResource Brush.TextFaint}"
                                                               Text="{l:Loc plan.schedule.dayHint}" />
                                                </StackPanel>

                                                <!-- Interval: every … hours from … to … -->
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="Interval">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Style="{StaticResource TextBlock.RowText}" Text="{l:Loc plan.schedule.every}" />
                                                    <TextBox Style="{StaticResource TextBox.Field}" Width="44" AutomationProperties.Name="{l:Loc plan.schedule.everyHours}"
                                                             Text="{Binding EveryHoursText, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Style="{StaticResource TextBlock.RowText}" Text="{l:Loc plan.schedule.hoursFrom}" />
                                                    <TextBox Style="{StaticResource TextBox.Field}" Width="64" AutomationProperties.Name="{l:Loc plan.schedule.from}"
                                                             Text="{Binding FromText, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Style="{StaticResource TextBlock.RowText}" Text="{l:Loc plan.schedule.to}" />
                                                    <TextBox Style="{StaticResource TextBox.Field}" Width="64" AutomationProperties.Name="{l:Loc plan.schedule.toName}"
                                                             Text="{Binding ToText, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Style="{StaticResource TextBlock.RowText}" FontSize="12"
                                                               Foreground="{DynamicResource Brush.TextFaint}" Text="{l:Loc plan.schedule.wholeDay}" />
                                                </StackPanel>
                                            </WrapPanel>
                                        </DockPanel>

                                        <!-- Weekly: weekdays -->
                                        <ItemsControl Margin="24,8,0,2" ItemsSource="{Binding Weekdays}" Focusable="False">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Weekly">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Margin="0,0,14,0" Content="{l:LocBind Name, Prefix=enum.weekdayShort.}" IsChecked="{Binding IsChecked}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Margin="24,6,0,2" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Danger}"
                                                   Text="{Binding Error}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Next runs as chips -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NextRuns.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource TextBlock.Muted}" Margin="0,8,0,8" FontSize="12" Text="{l:Loc plan.schedule.nextRuns}" />
                        <ItemsControl ItemsSource="{Binding NextRuns}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,8,8" Padding="10,4" CornerRadius="6" Background="{DynamicResource Brush.AccentSoft}">
                                        <TextBlock Style="{StaticResource TextBlock.Mono}" Foreground="{DynamicResource Brush.AccentLight}"
                                                   Text="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Tray hint, disabled plan, unsaved edits; Warning while the scheduler is paused. -->
                    <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding NextRunsNote}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Muted}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SchedulerPaused}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
        </DockPanel>
    </ScrollViewer>
</UserControl>
