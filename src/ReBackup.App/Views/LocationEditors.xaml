<!-- The editors of an S3 or Google Drive location (the target picker of the Plan tab and of "Copy plan…"). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:ReBackup.App.ViewModels"
                    xmlns:l="clr-namespace:ReBackup.Shared.Wpf.Localization;assembly=ReBackup.Shared.Wpf"
                    xmlns:s3="clr-namespace:ReBackup.Shared.Wpf.S3;assembly=ReBackup.Shared.Wpf"
                    xmlns:controls="clr-namespace:ReBackup.Shared.Wpf.Controls;assembly=ReBackup.Shared.Wpf"
                    xmlns:storage="clr-namespace:ReBackup.Storage.S3;assembly=ReBackup.Storage.S3">
    <BooleanToVisibilityConverter x:Key="Converter.Visible" />

    <!-- The S3 half of a source or target: connection, prefix and the connection test (S3LocationViewModel). -->
    <DataTemplate x:Key="S3LocationEditor" DataType="{x:Type vm:S3LocationViewModel}">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{l:Loc plan.s3.newConnection}"
                        Command="{Binding NewConnectionCommand}" AutomationProperties.Name="{l:Loc plan.s3.newConnection}" />
                <ComboBox MinHeight="34" ItemsSource="{Binding Connections}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedItem="{Binding SelectedConnection}" AutomationProperties.Name="{l:Loc plan.s3.connection}" />
            </DockPanel>

            <TextBlock Margin="0,8,0,6" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Text="{l:Loc plan.s3.prefix}" />
            <Grid>
                <TextBox MinHeight="34" FontFamily="{StaticResource Font.Mono}" FontSize="12" Padding="6,3"
                         VerticalContentAlignment="Center" AutomationProperties.Name="{l:Loc plan.s3.prefix}"
                         Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" />
                <!-- Placeholder while the prefix is empty (the whole bucket) -->
                <TextBlock Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False" FontFamily="{StaticResource Font.Mono}"
                           FontSize="12" Foreground="{DynamicResource Brush.TextFaint}" Text="{l:Loc plan.s3.prefixPlaceholder}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Prefix}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Left" MinWidth="80" Content="{l:Loc plan.s3.test}" Command="{Binding TestCommand}"
                        AutomationProperties.Name="{l:Loc plan.s3.test}" />
                <Button DockPanel.Dock="Left" Margin="8,0,0,0" Content="{l:Loc s3.test.cancel}" Command="{Binding CancelTestCommand}"
                        AutomationProperties.Name="{l:Loc s3.test.cancel}"
                        Visibility="{Binding IsTesting, Converter={StaticResource Converter.Visible}}" />
                <controls:ProgressRing DockPanel.Dock="Left" Width="18" Height="18" Thickness="2" IsIndeterminate="True" Margin="8,0,0,0"
                                       Visibility="{Binding IsTesting, Converter={StaticResource Converter.Visible}}" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextFaint}" Text="{l:Loc plan.s3.prefixHint}" />
            </DockPanel>

            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Results}" Focusable="False"
                          AutomationProperties.Name="{l:Loc s3.test.results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type storage:S3CheckResult}">
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold" VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static storage:S3CheckState.Ok}">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static storage:S3CheckState.Failed}">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static storage:S3CheckState.Warning}">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{x:Static s3:S3DialogTexts.Symbol}">
                                        <Binding />
                                        <Binding Path="Language" Source="{x:Static l:Loc.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Top" TextTrimming="CharacterEllipsis">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{x:Static s3:S3DialogTexts.CheckName}">
                                        <Binding />
                                        <Binding Path="Language" Source="{x:Static l:Loc.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Grid.Column="2" FontSize="12" Style="{StaticResource TextBlock.Muted}" TextWrapping="Wrap">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{x:Static s3:S3DialogTexts.Reason}">
                                        <Binding />
                                        <Binding Path="Language" Source="{x:Static l:Loc.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Cancelled, could not run, connection missing, secret to re-enter -->
            <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Warning}"
                       Text="{Binding TestStatus}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TestStatus}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </DataTemplate>

    <!-- The Google Drive half of a source or target: connection, path and the connection test (DriveLocationViewModel). -->
    <DataTemplate x:Key="DriveLocationEditor" DataType="{x:Type vm:DriveLocationViewModel}">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{l:Loc plan.drive.newConnection}"
                        Command="{Binding NewConnectionCommand}" AutomationProperties.Name="{l:Loc plan.drive.newConnection}" />
                <ComboBox MinHeight="34" ItemsSource="{Binding Connections}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedItem="{Binding SelectedConnection}" AutomationProperties.Name="{l:Loc plan.drive.connection}" />
            </DockPanel>

            <TextBlock Margin="0,8,0,6" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Text="{l:Loc plan.drive.path}" />
            <Grid>
                <TextBox MinHeight="34" FontFamily="{StaticResource Font.Mono}" FontSize="12" Padding="6,3"
                         VerticalContentAlignment="Center" AutomationProperties.Name="{l:Loc plan.drive.path}"
                         Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                <!-- Placeholder while the path is empty (the connection's root) -->
                <TextBlock Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False" FontFamily="{StaticResource Font.Mono}"
                           FontSize="12" Foreground="{DynamicResource Brush.TextFaint}" Text="{l:Loc plan.drive.pathPlaceholder}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Left" MinWidth="80" Content="{l:Loc plan.drive.run}" Command="{Binding TestCommand}"
                        AutomationProperties.Name="{l:Loc plan.drive.run}" />
                <Button DockPanel.Dock="Left" Margin="8,0,0,0" Content="{l:Loc s3.test.cancel}" Command="{Binding CancelTestCommand}"
                        AutomationProperties.Name="{l:Loc s3.test.cancel}"
                        Visibility="{Binding IsTesting, Converter={StaticResource Converter.Visible}}" />
                <controls:ProgressRing DockPanel.Dock="Left" Width="18" Height="18" Thickness="2" IsIndeterminate="True" Margin="8,0,0,0"
                                       Visibility="{Binding IsTesting, Converter={StaticResource Converter.Visible}}" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextFaint}" Text="{l:Loc plan.drive.pathHint}" />
            </DockPanel>

            <!-- The test's outcome: usable (accent), a problem (danger), or why there is no result (warning) -->
            <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding TestMessage}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TestPassed}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TestPassed}" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TestMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </DataTemplate>

    <!-- The Folder | S3 | Drive switch above a source or target. -->
    <Style x:Key="Border.KindSwitch" TargetType="Border">
        <Setter Property="DockPanel.Dock" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    </Style>

    <Style x:Key="RadioButton.Kind" TargetType="RadioButton" BasedOn="{StaticResource RadioButton.Segment}">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="1,0,0,0" />
    </Style>

    <!-- Path input with room for the folder button inside its right end. -->
    <Style x:Key="TextBox.Path" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="6,3,38,3" />
        <Setter Property="MinHeight" Value="34" />
    </Style>

    <Style x:Key="Button.Browse" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0,0,3,0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
