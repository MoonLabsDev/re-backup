<Window x:Class="ReBackup.App.Views.RelocationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ReBackup.Shared.Wpf.Localization;assembly=ReBackup.Shared.Wpf"
        Width="860" MinWidth="700" SizeToContent="Height" MinHeight="420" MaxHeight="760" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}">
    <!-- Moving ignore lines between the plan and a .backupignore: both diffs, refused lines, and whether the scope stays. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Converter.Visible" />

        <!-- One line of a diff: added green, removed red, unchanged muted; monospace. -->
        <DataTemplate x:Key="DiffLineTemplate">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Width="14" FontFamily="{StaticResource Font.Mono}" FontSize="12" Text="{Binding Marker}" />
                <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="12" TextWrapping="NoWrap" Text="{Binding Text}" />
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextMuted}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Added">
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.DiffAdded}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Danger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
            </DockPanel>
        </DataTemplate>

        <Style x:Key="Border.Diff" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Height" Value="220" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,18">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextBlock.CardTitle}" Margin="0,0,0,12" TextWrapping="Wrap" Text="{Binding Heading}" />
        <!-- The buttons and "Apply anyway" stay visible however long the content above gets; it scrolls. -->
        <DockPanel x:Name="ButtonRow" DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="False">
            <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" IsChecked="{Binding ApplyAnyway}"
                      Visibility="{Binding ShowApplyAnyway, Converter={StaticResource Converter.Visible}}">
                <TextBlock TextWrapping="Wrap" Text="{l:Loc ignore.relocation.applyAnywayCheck}" />
            </CheckBox>
            <Button DockPanel.Dock="Right" MinWidth="80" Margin="8,0,0,0" IsCancel="True" Content="{l:Loc common.cancel}"
                    AutomationProperties.Name="{l:Loc common.cancel}" />
            <Button DockPanel.Dock="Right" MinWidth="96" Style="{StaticResource Button.Accent}" IsDefault="True"
                    Content="{Binding ApplyText}" AutomationProperties.Name="{Binding ApplyText}"
                    IsEnabled="{Binding CanApply}" Click="OnApply" />
        </DockPanel>

        <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Plan patterns and the file, side by side -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextBlock.Muted}" FontSize="12" Margin="0,0,0,4"
                                   Text="{l:Loc ignore.relocation.planPatterns}" />
                        <Border Style="{StaticResource Border.Diff}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding PatternDiff}" ItemTemplate="{StaticResource DiffLineTemplate}"
                                              AutomationProperties.Name="{l:Loc ignore.relocation.planPatterns}" />
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextBlock.Muted}" FontSize="12" Margin="0,0,0,4"
                                   Text="{Binding FilePath}" />
                        <Border Style="{StaticResource Border.Diff}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FileDiff}" ItemTemplate="{StaticResource DiffLineTemplate}"
                                              AutomationProperties.Name="{Binding FilePath}" />
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Grid>

                <!-- Lines that stay in the plan (yellow), with their reason -->
                <StackPanel Margin="0,12,0,0" Visibility="{Binding HasRejected, Converter={StaticResource Converter.Visible}}">
                    <TextBlock FontSize="12" Foreground="{DynamicResource Brush.Warning}" Text="{l:Loc ignore.relocation.rejectedTitle}" />
                    <ItemsControl Margin="0,4,0,0" MaxHeight="100" ItemsSource="{Binding Rejected}"
                                  AutomationProperties.Name="{l:Loc ignore.relocation.rejectedTitle}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel TextElement.Foreground="{DynamicResource Brush.Warning}">
                                    <TextBlock DockPanel.Dock="Left" MinWidth="200" Margin="0,0,12,0" FontFamily="{StaticResource Font.Mono}"
                                               FontSize="12" Text="{Binding Line}" />
                                    <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding Reason}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Margin="0,12,0,0" FontSize="12" Foreground="{DynamicResource Brush.Warning}" Text="{l:Loc ignore.relocation.nothing}"
                           Visibility="{Binding NothingToMove, Converter={StaticResource Converter.Visible}}" />

                <!-- Equivalence: green, red with examples, or grey while waiting -->
                <Border Margin="0,14,0,0" Padding="10,8" CornerRadius="6" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextMuted}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EquivalenceState}" Value="Identical">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.DiffAdded}" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.DiffAdded}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding EquivalenceState}" Value="Differs">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding EquivalenceText}" />
                        <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding EquivalenceDetail}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EquivalenceDetail}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ListView Margin="0,8,0,0" MaxHeight="180" ItemsSource="{Binding Examples}"
                                  AutomationProperties.Name="{l:Loc ignore.relocation.examples}"
                                  Visibility="{Binding ShowApplyAnyway, Converter={StaticResource Converter.Visible}}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="380" Header="{l:Loc common.path}" DisplayMemberBinding="{Binding Path}" />
                                    <GridViewColumn Width="170" Header="{l:Loc ignore.relocation.change}" DisplayMemberBinding="{Binding Change}" />
                                    <GridViewColumn Width="200" Header="{l:Loc ignore.relocation.pattern}" DisplayMemberBinding="{Binding Pattern}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource TextBlock.Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="{l:Loc ignore.relocation.existingOnly}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
