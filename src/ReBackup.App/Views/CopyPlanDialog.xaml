<Window x:Class="ReBackup.App.Views.CopyPlanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ReBackup.Shared.Wpf.Localization;assembly=ReBackup.Shared.Wpf"
        Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}">
    <!-- "Copy plan…": name, new target (the Plan tab's picker), format; then progress, summary and what was not copied. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LocationEditors.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="TextBlock.Label" TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Muted}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
            <!-- A line that is shown only while it has a text. -->
            <Style x:Key="TextBlock.Optional" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,10,0,0" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                    <Trigger Property="Text" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="20,18">
        <TextBlock Style="{StaticResource TextBlock.CardTitle}" Margin="0,0,0,6" TextWrapping="Wrap" Text="{Binding Heading}" />
        <TextBlock Style="{StaticResource TextBlock.Muted}" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap" Text="{l:Loc copy.hint}" />

        <StackPanel IsEnabled="{Binding CanEditSettings}">
            <TextBlock Style="{StaticResource TextBlock.Label}" Text="{l:Loc common.name}" />
            <TextBox MinHeight="34" AutomationProperties.Name="{l:Loc common.name}"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <DockPanel Margin="0,12,0,0">
                <Border Style="{StaticResource Border.KindSwitch}" AutomationProperties.Name="{l:Loc plan.kind.targetName}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource RadioButton.Kind}" Content="{l:Loc plan.kind.folder}"
                                     IsChecked="{Binding TargetIsFolder, Mode=OneWay}"
                                     Command="{Binding ChooseTargetKindCommand}" CommandParameter="Folder" />
                        <RadioButton Style="{StaticResource RadioButton.Kind}" Content="{l:Loc plan.kind.s3}"
                                     IsChecked="{Binding TargetIsS3, Mode=OneWay}"
                                     Command="{Binding ChooseTargetKindCommand}" CommandParameter="S3" />
                        <RadioButton Style="{StaticResource RadioButton.Kind}" Content="{l:Loc plan.kind.drive}"
                                     IsChecked="{Binding TargetIsDrive, Mode=OneWay}"
                                     Command="{Binding ChooseTargetKindCommand}" CommandParameter="Drive" />
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource TextBlock.Label}" VerticalAlignment="Bottom" Text="{l:Loc plan.source.target}" />
            </DockPanel>
            <ContentControl Focusable="False" IsTabStop="False" Content="{Binding TargetS3}"
                            ContentTemplate="{StaticResource S3LocationEditor}"
                            Visibility="{Binding TargetIsS3, Converter={StaticResource Converter.Visible}}" />
            <ContentControl Focusable="False" IsTabStop="False" Content="{Binding TargetDrive}"
                            ContentTemplate="{StaticResource DriveLocationEditor}"
                            Visibility="{Binding TargetIsDrive, Converter={StaticResource Converter.Visible}}" />
            <Grid Visibility="{Binding TargetIsFolder, Converter={StaticResource Converter.Visible}}">
                <TextBox Style="{StaticResource TextBox.Path}" AutomationProperties.Name="{l:Loc plan.source.target}"
                         Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" />
                <Button Style="{StaticResource Button.Browse}" ToolTip="{l:Loc plan.source.chooseTarget}"
                        AutomationProperties.Name="{l:Loc plan.source.chooseTarget}" Command="{Binding BrowseTargetCommand}">
                    <Image Style="{StaticResource Image.FolderColored}" />
                </Button>
            </Grid>

            <DockPanel Margin="0,16,0,0">
                <Border Style="{StaticResource Border.KindSwitch}" AutomationProperties.Name="{l:Loc plan.format.title}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource RadioButton.Kind}" Content="{l:Loc plan.format.full}"
                                     IsChecked="{Binding IncrementalIsFull, Mode=OneWay}"
                                     Command="{Binding ChooseStorageFormatCommand}" CommandParameter="Full" />
                        <RadioButton Style="{StaticResource RadioButton.Kind}" Content="{l:Loc plan.format.incremental}"
                                     IsChecked="{Binding Incremental, Mode=OneWay}"
                                     Command="{Binding ChooseStorageFormatCommand}" CommandParameter="Incremental" />
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource TextBlock.Label}" VerticalAlignment="Bottom" Text="{l:Loc plan.format.title}" />
            </DockPanel>
        </StackPanel>

        <!-- Why the copy did not start -->
        <TextBlock Style="{StaticResource TextBlock.Optional}" Foreground="{DynamicResource Brush.Danger}" Text="{Binding Message}" />

        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsRunning, Converter={StaticResource Converter.Visible}}">
            <TextBlock Style="{StaticResource TextBlock.Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding ProgressText}" />
            <ProgressBar Margin="0,4,0,0" Height="6" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}" />
        </StackPanel>

        <TextBlock Style="{StaticResource TextBlock.Optional}" Text="{Binding Summary}" />
        <ListBox Margin="0,8,0,0" MaxHeight="200" ItemsSource="{Binding Failures}" AutomationProperties.Name="{l:Loc copy.failuresName}"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.Style>
                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Failures.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Style>
        </ListBox>

        <StackPanel Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button MinWidth="96" Style="{StaticResource Button.Accent}" IsDefault="True" Content="{l:Loc copy.start}"
                    AutomationProperties.Name="{l:Loc copy.start}" Command="{Binding StartCommand}" />
            <Button MinWidth="80" Margin="8,0,0,0" Content="{l:Loc common.cancel}" AutomationProperties.Name="{l:Loc common.cancel}"
                    Command="{Binding CancelCommand}" Visibility="{Binding IsRunning, Converter={StaticResource Converter.Visible}}" />
            <Button MinWidth="80" Margin="8,0,0,0" IsCancel="True" Content="{l:Loc common.close}"
                    AutomationProperties.Name="{l:Loc common.close}" />
        </StackPanel>
    </StackPanel>
</Window>
