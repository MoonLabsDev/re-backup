<UserControl x:Class="ReBackup.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ReBackup.Shared.Wpf.Localization;assembly=ReBackup.Shared.Wpf">
    <!-- DataContext: the plan's CleanupViewModel. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Right-aligned number cell. -->
        <Style x:Key="TextBlock.Number" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <!-- A plain text cell. -->
        <Style x:Key="TextBlock.Cell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0,6,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- A status line that takes no room while it is empty. -->
        <Style x:Key="TextBlock.Line" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="160" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================================================== Scan / Clean up… / Cancel -->
        <Border Grid.Row="0" Style="{StaticResource Border.Card}" Margin="0,0,0,16" Padding="18,14">
            <StackPanel>
                <TextBlock Style="{StaticResource TextBlock.CardTitle}" Text="{l:Loc cleanup.title}" />
                <TextBlock Style="{StaticResource TextBlock.Muted}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                           Text="{l:Loc cleanup.intro}" />
                <WrapPanel Margin="0,10,0,0">
                    <Button Margin="0,0,8,0" Content="{l:Loc cleanup.scan}" ToolTip="{l:Loc cleanup.scanToolTip}"
                            ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{l:Loc cleanup.scan}"
                            Command="{Binding ScanCommand}" />
                    <Button Style="{StaticResource Button.Accent}" Margin="0,0,8,0" Content="{l:Loc cleanup.cleanUp}"
                            ToolTip="{l:Loc cleanup.cleanUpToolTip}" ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="{l:Loc cleanup.cleanUp}" Command="{Binding CleanUpCommand}" />
                    <Button AutomationProperties.Name="{l:Loc common.cancel}" ToolTip="{l:Loc cleanup.cancelToolTip}"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding IsCleaningUp, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource TextBlock.Icon}" FontSize="12" Text="{StaticResource Icon.Stop}" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{l:Loc common.cancel}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <ProgressBar Margin="0,8,0,0" Height="4" IsIndeterminate="True"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Style="{StaticResource TextBlock.Line}" Foreground="{DynamicResource Brush.TextMuted}"
                           Text="{Binding Hint, TargetNullValue=''}" />

                <!-- A running cleanup: the Versions tab's progress of the job (current version, fraction). -->
                <StackPanel Margin="0,8,0,0" Visibility="{Binding IsCleaningUp, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Brush.AccentLight}"
                               Text="{Binding Versions.DeleteText}" />
                    <ProgressBar Margin="0,4,0,0" Height="6" Maximum="1" Value="{Binding Versions.DeleteFraction, Mode=OneWay}"
                                 IsIndeterminate="{Binding Versions.DeleteIndeterminate, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ======================================================== Versions, newest first -->
        <Border Grid.Row="1" Style="{StaticResource Border.Card}" Padding="0,8,0,0">
            <Grid>
                <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False"
                          CanUserResizeRows="False" Background="Transparent" BorderThickness="0"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                          AutomationProperties.Name="{l:Loc cleanup.list}"
                          VirtualizingPanel.IsVirtualizing="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="ToolTip" Value="{Binding Name}" />
                            <Style.Triggers>
                                <!-- Not managed, damaged or not indexed: greyed, no checkbox, the reason as tooltip. -->
                                <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                                    <Setter Property="Opacity" Value="0.6" />
                                    <Setter Property="ToolTip" Value="{Binding NotSelectableReason}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44" CanUserResize="False">
                            <DataGridTemplateColumn.Header>
                                <CheckBox IsThreeState="True" Margin="6,0,0,0" HorizontalAlignment="Center"
                                          ToolTip="{l:Loc cleanup.checkAll}" AutomationProperties.Name="{l:Loc cleanup.checkAll}"
                                          IsChecked="{Binding DataContext.AllChecked, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                              AutomationProperties.Name="{Binding Name}"
                                              IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                              Visibility="{Binding IsSelectable, Converter={StaticResource BoolToVisibility}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:Loc common.date}" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource TextBlock.Cell}" FontWeight="SemiBold"
                                               Typography.NumeralAlignment="Tabular" Text="{Binding DateText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:Loc common.size}" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource TextBlock.Number}" Text="{Binding SizeText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:Loc common.files}" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource TextBlock.Number}" Text="{Binding FilesText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:Loc cleanup.column.removes}" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource TextBlock.Number}" Text="{Binding RemovesText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:Loc cleanup.column.frees}" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource TextBlock.Number}" Text="{Binding FreesText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:Loc common.status}" Width="*" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource TextBlock.Cell}" Text="{Binding StatusText}"
                                               ToolTip="{Binding StatusText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Style="{StaticResource TextBlock.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="{l:Loc versions.empty}"
                           Visibility="{Binding Versions.ShowEmpty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- ======================================================== Totals, by rule -->
        <Border Grid.Row="2" Style="{StaticResource Border.Card}" Margin="0,16,0,0" Padding="18,14">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Typography.NumeralAlignment="Tabular"
                           Text="{Binding TotalsText}" />
                <TextBlock Style="{StaticResource TextBlock.CardTitle}" Margin="0,12,0,6" Text="{l:Loc cleanup.byRule.title}" />
                <!-- Header and lines share their column widths. -->
                <Grid Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="160" SharedSizeGroup="Rule" />
                            <ColumnDefinition Width="Auto" MinWidth="140" SharedSizeGroup="Origin" />
                            <ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="Files" />
                            <ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="Size" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource TextBlock.Muted}" FontSize="12" Margin="0,0,12,0" Text="{l:Loc cleanup.byRule.rule}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TextBlock.Muted}" FontSize="12" Margin="0,0,12,0" Text="{l:Loc cleanup.byRule.origin}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource TextBlock.Muted}" FontSize="12" Margin="0,0,12,0" TextAlignment="Right" Text="{l:Loc common.files}" />
                        <TextBlock Grid.Column="3" Style="{StaticResource TextBlock.Muted}" FontSize="12" Margin="0,0,12,0" TextAlignment="Right" Text="{l:Loc common.size}" />
                        <TextBlock Grid.Column="4" Style="{StaticResource TextBlock.Muted}" FontSize="12" Text="{l:Loc cleanup.byRule.largestHeader}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ByRule}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Rule" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Origin" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Files" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Size" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Margin="0,0,12,0" FontFamily="{StaticResource Font.Mono}" FontSize="12" VerticalAlignment="Center" Text="{Binding Rule}" />
                                        <TextBlock Grid.Column="1" Margin="0,0,12,0" Foreground="{DynamicResource Brush.TextMuted}"
                                                   Text="{Binding OriginText}" />
                                        <TextBlock Grid.Column="2" Margin="0,0,12,0" TextAlignment="Right"
                                                   Typography.NumeralAlignment="Tabular" Text="{Binding FilesText}" />
                                        <TextBlock Grid.Column="3" Margin="0,0,12,0" TextAlignment="Right"
                                                   Typography.NumeralAlignment="Tabular" Text="{Binding SizeText}" />
                                        <TextBlock Grid.Column="4" Foreground="{DynamicResource Brush.TextMuted}"
                                                   TextTrimming="CharacterEllipsis" Text="{Binding LargestText}"
                                                   ToolTip="{Binding LargestText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
