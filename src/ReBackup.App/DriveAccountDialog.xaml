<Window x:Class="ReBackup.App.DriveAccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ReBackup.Shared.Wpf.Localization;assembly=ReBackup.Shared.Wpf"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}">
    <!-- Add or edit one Google service account: a name and its key file; the view model holds the logic. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Converter.Visible" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,18">
        <TextBlock Style="{StaticResource TextBlock.Muted}" Margin="0,0,0,14" FontSize="12" TextWrapping="Wrap"
                   Text="{l:Loc driveaccounts.dialogNote}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{l:Loc common.name}" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{l:Loc common.name}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldError}" Text="{Binding NameError}" />

            <TextBlock Grid.Row="2" Margin="0,10,14,0" Style="{StaticResource FieldLabel}" Text="{l:Loc driveaccounts.key}" />
            <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" MinWidth="120" Content="{l:Loc driveaccounts.chooseKey}"
                        Command="{Binding ChooseKeyCommand}" AutomationProperties.Name="{l:Loc driveaccounts.chooseKey}" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource TextBlock.Mono}" TextTrimming="CharacterEllipsis"
                           Text="{Binding KeyFileName}" />
            </DockPanel>
            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldError}" Text="{Binding KeyError}" />
        </Grid>

        <!-- The service account's e-mail: the address folders and shared drives are shared with -->
        <Border Margin="0,14,0,0" Style="{StaticResource Border.Card}"
                Visibility="{Binding HasClientEmail, Converter={StaticResource Converter.Visible}}">
            <StackPanel>
                <TextBlock FontSize="12" Style="{StaticResource TextBlock.Muted}" Text="{l:Loc driveaccounts.email}" />
                <TextBox Margin="0,4,0,0" IsReadOnly="True" Style="{StaticResource {x:Type TextBox}}" FontFamily="{StaticResource Font.Mono}"
                         Text="{Binding ClientEmail, Mode=OneWay}" AutomationProperties.Name="{l:Loc driveaccounts.email}" />
                <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Style="{StaticResource TextBlock.Muted}"
                           Text="{l:Loc driveaccounts.shareHint}" />
            </StackPanel>
        </Border>
        <TextBlock Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Warning}"
                   Text="{l:Loc driveaccounts.needsKeyHint}"
                   Visibility="{Binding NeedsKey, Converter={StaticResource Converter.Visible}}" />

        <StackPanel Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{l:Loc s3.dialog.save}" MinWidth="96" Style="{StaticResource Button.Accent}" IsDefault="True"
                    Command="{Binding SaveCommand}" AutomationProperties.Name="{l:Loc s3.dialog.save}" />
            <Button Content="{l:Loc s3.dialog.cancel}" MinWidth="80" Margin="8,0,0,0" IsCancel="True"
                    AutomationProperties.Name="{l:Loc s3.dialog.cancel}" />
        </StackPanel>
    </StackPanel>
</Window>
