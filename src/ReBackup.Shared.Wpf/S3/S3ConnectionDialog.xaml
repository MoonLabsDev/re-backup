<Window x:Class="ReBackup.Shared.Wpf.S3.S3ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ReBackup.Shared.Wpf.Localization"
        xmlns:s3="clr-namespace:ReBackup.Shared.Wpf.S3"
        xmlns:controls="clr-namespace:ReBackup.Shared.Wpf.Controls"
        xmlns:storage="clr-namespace:ReBackup.Storage.S3;assembly=ReBackup.Storage.S3"
        Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}">
    <!-- Add or edit one S3 connection; the view model holds the logic. The secret goes from the PasswordBox to the view model in code-behind only. -->
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,18">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Name -->
            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{l:Loc s3.field.name}" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsEditable}" AutomationProperties.Name="{l:Loc s3.field.name}" />
            <TextBlock Grid.Row="1" Grid.Column="1">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource FieldHint}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NameHintKey}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <TextBlock.Text>
                    <MultiBinding Converter="{x:Static s3:S3DialogTexts.Label}">
                        <Binding Path="NameHintKey" />
                        <Binding Path="Language" Source="{x:Static l:Loc.Instance}" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <!-- Region: the common regions, or any typed name -->
            <TextBlock Grid.Row="2" Margin="0,10,14,0" Style="{StaticResource FieldLabel}" Text="{l:Loc s3.field.region}" />
            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" IsEditable="True" IsTextSearchEnabled="True"
                      ItemsSource="{x:Static s3:AwsRegions.All}" Text="{Binding Region, UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding IsEditable}" AutomationProperties.Name="{l:Loc s3.field.region}" />

            <!-- Bucket -->
            <TextBlock Grid.Row="3" Margin="0,10,14,0" Style="{StaticResource FieldLabel}" Text="{l:Loc s3.field.bucket}" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" Text="{Binding Bucket, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsEditable}" AutomationProperties.Name="{l:Loc s3.field.bucket}" />
            <TextBlock Grid.Row="4" Grid.Column="1">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource FieldHint}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BucketHintKey}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <TextBlock.Text>
                    <MultiBinding Converter="{x:Static s3:S3DialogTexts.Label}">
                        <Binding Path="BucketHintKey" />
                        <Binding Path="Language" Source="{x:Static l:Loc.Instance}" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <!-- Access key ID -->
            <TextBlock Grid.Row="5" Margin="0,10,14,0" Style="{StaticResource FieldLabel}" Text="{l:Loc s3.field.accessKeyId}" />
            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,10,0,0" Text="{Binding AccessKeyId, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource Font.Mono}" IsEnabled="{Binding IsEditable}"
                     AutomationProperties.Name="{l:Loc s3.field.accessKeyId}" />

            <!-- Secret: placeholder "unchanged" / "re-enter" while empty -->
            <TextBlock Grid.Row="6" Margin="0,10,14,0" Style="{StaticResource FieldLabel}" Text="{l:Loc s3.field.secret}" />
            <Grid Grid.Row="6" Grid.Column="1" Margin="0,10,0,0">
                <PasswordBox x:Name="SecretBox" PasswordChanged="OnSecretChanged" IsEnabled="{Binding IsEditable}"
                             AutomationProperties.Name="{l:Loc s3.field.secret}" />
                <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Brush.TextFaint}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Secret}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <TextBlock.Text>
                        <MultiBinding Converter="{x:Static s3:S3DialogTexts.Label}">
                            <Binding Path="SecretPlaceholderKey" />
                            <Binding Path="Language" Source="{x:Static l:Loc.Instance}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>
        </Grid>

        <!-- Test connection (optional) -->
        <Border Margin="0,18,0,0" Padding="0,14,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{l:Loc s3.test.cancel}" MinWidth="96" Margin="8,0,0,0"
                            Command="{Binding CancelTestCommand}" AutomationProperties.Name="{l:Loc s3.test.cancel}" />
                    <Button DockPanel.Dock="Right" Content="{l:Loc s3.test.run}" MinWidth="120" Margin="8,0,0,0"
                            Command="{Binding TestCommand}" AutomationProperties.Name="{l:Loc s3.test.run}" />
                    <controls:ProgressRing DockPanel.Dock="Right" Width="18" Height="18" Thickness="2" IsIndeterminate="True"
                                           Margin="8,0,0,0">
                        <controls:ProgressRing.Style>
                            <Style TargetType="controls:ProgressRing" BasedOn="{StaticResource {x:Type controls:ProgressRing}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTesting}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:ProgressRing.Style>
                    </controls:ProgressRing>
                    <CheckBox VerticalAlignment="Center" Content="{l:Loc s3.test.checkWrite}" IsChecked="{Binding CheckWrite}"
                              IsEnabled="{Binding IsEditable}" AutomationProperties.Name="{l:Loc s3.test.checkWrite}" />
                </DockPanel>

                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Results}" Focusable="False"
                              AutomationProperties.Name="{l:Loc s3.test.results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type storage:S3CheckResult}">
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static storage:S3CheckState.Ok}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static storage:S3CheckState.Failed}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static storage:S3CheckState.Warning}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{x:Static s3:S3DialogTexts.Symbol}">
                                            <Binding />
                                            <Binding Path="Language" Source="{x:Static l:Loc.Instance}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{x:Static s3:S3DialogTexts.CheckName}">
                                            <Binding />
                                            <Binding Path="Language" Source="{x:Static l:Loc.Instance}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Grid.Column="2" Style="{StaticResource TextBlock.Muted}" VerticalAlignment="Center" TextWrapping="Wrap">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{x:Static s3:S3DialogTexts.Reason}">
                                            <Binding />
                                            <Binding Path="Language" Source="{x:Static l:Loc.Instance}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <!-- A region warning offers the bucket's region. -->
                                <Button Grid.Column="3" Margin="8,0,0,0" CommandParameter="{Binding Detail}"
                                        Command="{Binding DataContext.UseRegionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MessageKey}" Value="{x:Static storage:S3MessageKeys.RegionMismatch}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Content>
                                        <MultiBinding Converter="{x:Static s3:S3DialogTexts.UseRegion}">
                                            <Binding />
                                            <Binding Path="Language" Source="{x:Static l:Loc.Instance}" />
                                        </MultiBinding>
                                    </Button.Content>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Cancelled, or could not run -->
                <TextBlock Margin="0,6,0,0" Style="{StaticResource TextBlock.Muted}" TextWrapping="Wrap">
                    <TextBlock.Text>
                        <MultiBinding Converter="{x:Static s3:S3DialogTexts.Label}">
                            <Binding Path="TestStatusKey" />
                            <Binding Path="Language" Source="{x:Static l:Loc.Instance}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </Border>

        <StackPanel Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{l:Loc s3.dialog.save}" MinWidth="96" Style="{StaticResource Button.Accent}" IsDefault="True"
                    Command="{Binding SaveCommand}" AutomationProperties.Name="{l:Loc s3.dialog.save}" />
            <Button Content="{l:Loc s3.dialog.cancel}" MinWidth="80" Margin="8,0,0,0" IsCancel="True"
                    AutomationProperties.Name="{l:Loc s3.dialog.cancel}" />
        </StackPanel>
    </StackPanel>
</Window>
